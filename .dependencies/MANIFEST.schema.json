{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MANIFEST.schema.json",
  "title": ".dependencies manifest",
  "type": "object",
  "required": ["version", "policy", "deps"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "policy": {
      "type": "object",
      "required": ["rule", "pinnedMutable", "repinRequired"],
      "properties": {
        "rule": { "type": "string" },
        "pinnedMutable": { "type": "boolean" },
        "repinRequired": { "type": "string" },
        "evalLifecycle": { "type": "string" },
        "upstreamSource": { "type": "string" }
      }
    },
    "deps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "upstream", "pinned"],
        "properties": {
          "description": { "type": "string" },
          "upstream": { "type": "string" },
          "pinned": {
            "type": "object",
            "required": ["ref", "path", "consumedBy"],
            "properties": {
              "ref": { "type": "string" },
              "resolvedSha": { "type": ["string", "null"] },
              "note": { "type": "string" },
              "path": { "type": "string" },
              "consumedBy": { "type": "string" },
              "verification": { "type": "string" }
            }
          },
          "eval": {
            "type": "object",
            "required": ["ref", "path"],
            "properties": {
              "ref": { "type": "string" },
              "resolvedSha": { "type": ["string", "null"] },
              "note": { "type": "string" },
              "path": { "type": "string" }
            }
          }
        }
      }
    },
    "pending": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
