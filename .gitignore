# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Test / coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# All context directories at any depth (reference material).
# `context` without a slash also covers a symlink of that name; `context/` does not.
context
context/

# Local environment setup doc (machine-specific)
.local-dsh-setup.md
.local-desktop-setup.md
.local-perf-review.md

# skill working files
.impeccable/
.dsh/
# cf CLI local cache (account id etc; token lives in .env.cloudflare)
.cloudflare/

# Release artifacts (produced by CI, published to GitHub Releases)
*.tgz
SHA256SUMS.txt
SHA256SUMS.sigstore.json
release/

# Rust / Wasm (future plugins)
# NOTE: Cargo.lock stays committed — reproducible builds depend on it.
target/
**/*.wasm

# Lab (perf-review). Baseline IS committed; local config and run output are not.
lab/config.local.json
lab/out/

# 业主文件
.adocs
.anote
.output
.temp

# 开发工作树 dev worktree
.worktree/

