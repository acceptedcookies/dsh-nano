{
  "name": "dsh-nano-cloud-session-host",
  "version": "0.1.0",
  "description": "Host/client overlay companion for dsh-nano-cloud-session: swaps the stock session, terminal, workspace-file, conversation and right-sidebar rows for the patched native external-session build so external (cloud) Sessions render natively.",
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "AGENTS.md",
    "cordis.patch.yml",
    "lib",
    "icon.svg",
    "locale",
    "DETAIL.zh.md",
    "DETAIL.en.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./session-controller": "./lib/host-session-controller.js",
    "./terminal-controller": "./lib/host-terminal-controller.js",
    "./workspace-files": "./lib/host-workspace-files.js",
    "./remotes": "./lib/host-remotes.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "overlay": "node scripts/build-overlay.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-attachment": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-brand": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-deque": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-fs": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-lazy-require": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-native-command": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session-query": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session-title": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-timeout": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-util-ripgrep": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-util-time": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "mime-types": "^3.0.2",
    "zod": "^4.6.7"
  },
