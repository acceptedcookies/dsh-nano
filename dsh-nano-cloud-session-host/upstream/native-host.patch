+/** One bounded non-PTY SSH read; the request body is JSON on stdin, never argv. */
+async function invoke(
+  grant: ExternalWorkspaceGrant,
+  request: Record<string, unknown>,
+  signal: AbortSignal,
+): Promise<Record<string, unknown>> {
+  /* execFile has no `input` option: the request JSON is written to the
+   * child's stdin ourselves, so nothing from the caller reaches argv. */
+  /* OpenSSH joins remote-command argv with spaces, so an unquoted helper
+   * body would split into fragments. The single argv element carries the
+   * fixed code base64-encoded inside shell quotes the remote shell strips. */
+  const child = execFileAsync(
+    '/usr/bin/ssh',
+    [...sshClientArgs(grant), `python3 -c 'exec(__import__("base64").b64decode("${HELPER_B64}").decode())'`],
+    {
+      timeout: 30_000,
+      maxBuffer: 8 * 1024 * 1024,
+      signal,
+      env: { PATH: '/usr/bin:/bin' },
+    },
+  )
+  child.child.stdin?.end(JSON.stringify({ root: grant.root, ...request }))
+  const { stdout } = await child
+  const parsed = JSON.parse(stdout) as { ok?: boolean; error?: { kind?: string; message?: string }; result?: Record<string, unknown> }
+  if (parsed.ok === true && parsed.result !== undefined) return parsed.result
+  const kind = parsed.error?.kind
+  if (kind === 'not-found') throw new RemoteError('workspace-file/not-found', String(parsed.error?.message ?? 'not found'), { path: String(request.path ?? '') })
+  if (kind === 'confined') throw new RemoteError('workspace-file/outside-workspace', String(parsed.error?.message ?? 'outside workspace'), { path: String(request.path ?? '') })
+  if (kind === 'not-file') throw new RemoteError('workspace-file/not-regular-file', String(parsed.error?.message ?? 'not a regular file'), { path: String(request.path ?? ''), kind: 'other' })
+  if (kind === 'too-large') throw new RemoteError('workspace-file/too-large', String(parsed.error?.message ?? 'too large'), { path: String(request.path ?? ''), limit: 0 })
+  throw new RemoteError('workspace-file/external-unavailable', `external workspace read failed: ${String(parsed.error?.message ?? 'unknown')}`, {})
+}
+
+/** Directory listing entry as produced by the remote helper. */
+export interface ExternalDirEntry {
+  readonly name: string
+  readonly kind: 'file' | 'directory' | 'other'
+  readonly size: number
+  readonly mtime: number
+}
+
+/** Stat facts as produced by the remote helper. */
+export interface ExternalStatResult {
+  readonly kind: 'file' | 'directory' | 'other'
+  readonly size: number
+  readonly mtime: number
+  readonly dev: number
+  readonly ino: number
+}
+
+/** One granted, registration-bound read-only remote root. */
+export interface ExternalFileBackend {
+  stat(path: string, signal: AbortSignal): Promise<ExternalStatResult>
+  list(path: string, maxEntries: number, signal: AbortSignal): Promise<{ entries: ExternalDirEntry[]; truncated: boolean }>
+  bytes(path: string, range: { offset?: number; length?: number }, maxBytes: number, signal: AbortSignal): Promise<{ data: Uint8Array; eof: boolean } & Omit<ExternalStatResult, 'kind'>>
+}
+
+/**
+ * Bind the read-only SSH backend to one verified grant. The returned backend
+ * reads only through the grant; it has no local filesystem and no fallback.
+ * @param grant - the exact binding approved for this external Session id.
+ */
+export function createExternalFileBackend(grant: ExternalWorkspaceGrant): ExternalFileBackend {
+  return {
+    stat: (path, signal) => invoke(grant, { op: 'stat', path }, signal) as unknown as Promise<ExternalStatResult>,
+    list: (path, maxEntries, signal) => invoke(grant, { op: 'list', path, maxEntries }, signal) as Promise<{ entries: ExternalDirEntry[]; truncated: boolean }>,
+    bytes: async (path, range, maxBytes, signal) => {
+      const result = await invoke(grant, { op: 'bytes', path, maxBytes, offset: range.offset ?? 0, length: range.length }, signal) as { bytes: string; eof: boolean } & Omit<ExternalStatResult, 'kind'>
+      return { ...result, data: new Uint8Array(Buffer.from(result.bytes, 'base64')) }
+    },
+  }
+}
