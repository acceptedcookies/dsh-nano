 })
+
+describe('external assistant display-only events', () => {
+  const externalEntries = [
+    at(0, 'user/message', textMessage('u-1', 'fixture ping'), { surfaceOp: 'append' }),
+    at(1, 'external/assistant-message', { id: 'e-assistant-1', text: 'DNCS-NATIVE-OK' }, { ignorable: true }),
+  ]
+
+  it('projects one settled assistant-step node per external event', () => {
+    const current = snapshot(assembler(externalEntries))
+    const visible = current.order.map(key => current.nodes.get(key))
+    expect(visible.map(candidate => candidate?.kind)).toEqual(['user', 'assistant-step'])
+    const reply = visible[1]?.data as AssistantChatData
+    expect(reply.status).toBe('settled')
+    expect(reply.turn).toBe(0)
+    expect(reply.step).toBe(2)
+    expect(reply.blocks).toEqual([{ kind: 'text', text: 'DNCS-NATIVE-OK' }])
+    expect(reply.finalNode).toMatchObject({
+      kind: 'assistant', seq: 1, messageId: 'e-assistant-1', turn: 0, step: 2,
+      blocks: [{ kind: 'text', text: 'DNCS-NATIVE-OK' }],
+    })
+    /* Nothing fabricates a local execution: no turn/step/process evidence and
+     * no usage pill data exists in the projection. */
+    const kinds = [...current.nodes.values()].map(candidate => candidate.kind)
+    for (const synthetic of ['turn', 'turn-process', 'turn-tail', 'usage', 'process']) {
+      expect(kinds).not.toContain(synthetic)
+    }
+    expect(current.order.filter(key => current.nodes.get(key)?.kind === 'assistant-step')).toHaveLength(1)
+  })
+
+  it('handles incremental append and reopen identically', () => {
+    const incremental = assembler()
+    for (const entry of externalEntries) {
+      incremental.append(entry)
+      incremental.flush()
+    }
+    const first = snapshot(incremental)
+    expect(first.order).toHaveLength(2)
+    const reopened = snapshot(assembler(externalEntries))
+    expect(reopened.order).toEqual(first.order)
+    expect((reopened.nodes.get(reopened.order[1]!)?.data as AssistantChatData).finalNode?.messageId)
+      .toBe('e-assistant-1')
+    /* A second external assistant row appends a second node without touching
+     * the first. */
+    incremental.append(at(2, 'external/assistant-message', { id: 'e-assistant-2', text: 'next' }, { ignorable: true }))
+    incremental.flush()
+    const grown = snapshot(incremental)
+    expect(grown.order.map(key => grown.nodes.get(key)?.kind)).toEqual(['user', 'assistant-step', 'assistant-step'])
+    const ids = grown.order
+      .map(key => (grown.nodes.get(key)?.data as AssistantChatData).finalNode?.messageId)
+      .filter(Boolean)
+    expect(new Set(ids).size).toBe(ids.length)
+  })
+})
