@@ -0,0 +1,240 @@
+/** The external SSH workspace: grant binding, literal argv, confinement, and refusal without a binding. */
+import { describe, expect, it, vi, beforeEach } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import TypertRegistry from '@deepseek-ai/dsh-typert-registry'
+import type { ExternalWorkspaceGrant } from '@deepseek-ai/dsh-api-session-controller'
+import WorkspaceFiles from '../src/index.ts'
+
+const { execFile, stdinWrites } = vi.hoisted(() => ({ execFile: vi.fn(), stdinWrites: [] as string[] }))
+vi.mock('node:child_process', async (importOriginal) => {
+  const util = await import('node:util')
+  const mod = await importOriginal<typeof import('node:child_process')>()
+  const callable = execFile as unknown as Record<PropertyKey, unknown>
+  callable[util.promisify.custom] = (command: string, argv: string[], options: object) => {
+    let childRef: unknown
+    const promise = new Promise((resolve, reject) => {
+      childRef = execFile(command, argv, options, (error: Error | null, stdout: string, stderr: string) =>
+        error === null || error === undefined ? resolve({ stdout, stderr }) : reject(error))
+    })
+    ;(promise as { child?: unknown }).child = childRef
+    return promise
+  }
+  return { ...mod, execFile }
+})
+
+const CAPS = {
+  maxBytes: 1024,
+  maxFileBytes: 1024,
+  maxLines: 100,
+  maxEntries: 3,
+  search: { maxResults: 100, maxEntries: 1000, graceMs: 3000, timeoutMs: 30000, stderrMaxBytes: 65536 },
+}
+
+const GRANT: ExternalWorkspaceGrant = Object.freeze({
+  externalSessionId: 'external:devin:cHJvZmlsZQ:remote-1:0',
+  endpoint: 'ssh.devin.ai',
+  user: 'devin-remote-1',
+  identityFile: '/Users/test/.ssh/id_ed25519',
+  knownHostsFile: '/Users/test/.dsh/known-hosts',
+  root: '/home/ubuntu/probe',
+  terminal: true,
+})
+const ID = SessionId(GRANT.externalSessionId)
+
+function ok(result: Record<string, unknown>) {
+  return JSON.stringify({ ok: true, result })
+}
+function fail(kind: string, message: string) {
+  return JSON.stringify({ ok: false, error: { kind, message } })
+}
+
+/** The last SSH call's argv tail and stdin JSON request. */
+function lastCall(): { argv: string[]; request: Record<string, unknown>; options: Record<string, unknown> } {
+  const call = execFile.mock.calls.at(-1)
+  if (call === undefined) throw new Error('ssh was not invoked')
+  const [command, argv, options] = call as unknown as [string, string[], Record<string, unknown>]
+  expect(command).toBe('/usr/bin/ssh')
+  return { argv, request: JSON.parse(stdinWrites.at(-1) ?? '') as Record<string, unknown>, options }
+}
+
+async function boot(grant?: ExternalWorkspaceGrant) {
+  const ctx = new Context()
+  ctx.provide('fs', {} as never)
+  ctx.provide('sandboxPolicy', { workspaceRoot: '/fallback' } as never)
+  ctx.provide('sessionPersistence', { stat: async () => undefined } as never)
+  const lifetime = new AbortController()
+  ctx.provide('sessionController', {
+    externalSessions: {
+      grantOf: (sessionId: string) => grant !== undefined && sessionId === grant.externalSessionId
+        ? { grant, entry: { view: {}, signal: lifetime.signal } }
+        : undefined,
+      current: (sessionId: string, entry: { signal: AbortSignal }) => entry.signal.aborted === false && sessionId === grant?.externalSessionId,
+    },
+  } as never)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(TypertRegistry)
+  await ctx.plugin(WorkspaceFiles, CAPS)
+  const workspaceFiles = ctx.get('workspaceFiles')
+  if (workspaceFiles === undefined) throw new Error('workspaceFiles service did not register')
+  const lookup = ctx.typert.lookups.get('workspaceFileScope')
+  if (lookup === undefined) throw new Error('workspaceFileScope lookup did not register')
+  return { ctx, workspaceFiles, lookup: lookup as { resolve(id: SessionId): Promise<unknown> }, lifetime }
+}
+
+beforeEach(() => {
+  execFile.mockReset()
+  stdinWrites.length = 0
+  execFile.mockImplementation((_cmd: string, _argv: string[], _options: object, cb: (error: null, stdout: string, stderr: string) => void) => {
+    const respond = (data: string) => {
+    stdinWrites.push(data)
+    const request = JSON.parse(data) as { op?: string; path?: string; offset?: number; length?: number }
+    let body: string
+    switch (request.op) {
+      case 'stat':
+        body = request.path === 'outside' || request.path?.includes('..') === true
+          ? fail('confined', 'path resolves outside the root')
+          : ok({ kind: 'file', size: 12, mtime: 1700000000000, dev: 1, ino: 2 })
+        break
+      case 'list':
+        body = ok({
+          entries: [
+            { name: 'b.txt', kind: 'file', size: 4, mtime: 1 },
+            { name: 'adir', kind: 'directory', size: 0, mtime: 1 },
+            { name: 'fifo', kind: 'other', size: 0, mtime: 1 },
+          ],
+          truncated: false,
+        })
+        break
+      case 'bytes': {
+        const full = Buffer.from('hello\nworld\n')
+        const offset = typeof request.offset === 'number' ? request.offset : 0
+        const length = typeof request.length === 'number' ? request.length : full.length
+        const data = full.subarray(offset, offset + length)
+        body = ok({
+          bytes: data.toString('base64'),
+          eof: offset + data.length >= full.length, size: full.length, mtime: 1700000000000, dev: 1, ino: 2,
+        })
+        break
+      }
+      default:
+        body = fail('invalid', 'unknown op')
+    }
+    cb(null, body, '')
+    }
+    return { stdin: { end: (data: string) => queueMicrotask(() => respond(data)) } } as never
+  })
+})
+
+describe('external workspace scope lookup', () => {
+  it('withholds the scope without a grant and binds the grant root when approved', async () => {
+    const missing = await boot()
+    await expect(missing.lookup.resolve(ID)).resolves.toBeUndefined()
+
+    const { lookup } = await boot(GRANT)
+    const scope = await lookup.resolve(ID) as { workspaceRoot: string; external?: { backend: object; signal: AbortSignal } }
+    expect(scope.workspaceRoot).toBe('/home/ubuntu/probe')
+    expect(scope.external?.backend).toBeTypeOf('object')
+    await expect(lookup.resolve(SessionId('external:other'))).resolves.toBeUndefined()
+  })
+})
+
+describe('external reads ride the granted SSH transport', () => {
+  it('invokes literal ssh argv with strict flags and JSON over stdin, never browser fields', async () => {
+    const { workspaceFiles, lookup } = await boot(GRANT)
+    const scope = await lookup.resolve(ID) as never
+    const stat = await workspaceFiles.stat(scope, 'sentinel.txt', new AbortController().signal)
+    expect(stat.bytes).toBe(12)
+    expect(stat.absolutePath).toBe('/home/ubuntu/probe/sentinel.txt')
+    expect(stat.version).toBe('1:2:1700000000000')
+
+    const { argv, request, options } = lastCall()
+    expect(argv).toEqual(expect.arrayContaining([
+      '-F', '/dev/null', '-i', GRANT.identityFile, '-oBatchMode=yes', '-oIdentitiesOnly=yes',
+      '-oStrictHostKeyChecking=yes', `-oUserKnownHostsFile=${GRANT.knownHostsFile}`,
+      '-oForwardAgent=no', '-oClearAllForwardings=yes', '-oPermitLocalCommand=no', '--',
