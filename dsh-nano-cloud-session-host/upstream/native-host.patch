index 0000000000..2076481005
--- /dev/null
+++ b/packages/client/ui-chat/src/client/conversation-nodes/external.ts
@@ -0,0 +1,60 @@
+import type { Context } from '@deepseek-ai/cordis'
+import type {
+  AssistantMessageNode, ConversationNodeDefinition,
+} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { AssistantChatData } from '../contract/chat-nodes.ts'
+import { MessageId } from '@deepseek-ai/dsh-llm/brand'
+import { chatNode } from './common.ts'
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    /** Display-only provider-side assistant message for external Sessions:
+     * `ignorable` on the wire, never persisted, painted by the native
+     * assistant-step renderer through this Definition only. */
+    'external/assistant-message': { readonly id: string; readonly text: string }
+  }
+}
+
+/**
+ * Display-only projection of a provider-side assistant message. External
+ * Sessions have no local turn, step, stream, or usage — the settled state is
+ * built once at the 'start' role and painted by the native assistant-step
+ * renderer; the wire entry is `ignorable` and never persisted.
+ */
+export const externalAssistantDefinition: ConversationNodeDefinition<AssistantChatData> = {
+  kind: 'external-assistant',
+  target: 'chat',
+  match: (event) => {
+    if (event.type !== 'external/assistant-message') return null
+    const { id } = event.data
+    if (id == null || id === '') return null
+    return { id: String(id), role: 'start' }
+  },
+  start: (_context, match): AssistantChatData => {
+    const { id, text } = match.event.data as { readonly id: string; readonly text: string }
+    if (typeof text !== 'string') throw new Error('external/assistant-message: missing text')
+    const seq = match.event.seq
+    const blocks = [{ kind: 'text' as const, text }]
+    const finalNode: AssistantMessageNode = {
+      kind: 'assistant', seq, messageId: MessageId(String(id)), time: match.event.time,
+      turn: 0, step: seq + 1, blocks,
+    }
+    return { status: 'settled', turn: 0, step: seq + 1, blocks, time: match.event.time, finalNode }
+  },
+  update: context => context.state,
+  buildViewNode: (context) => context.state?.finalNode === undefined
+    ? null
+    : chatNode(context, 'assistant-step', context.state.finalNode.seq, context.state),
+}
+
+/**
+ * Register the display-only external assistant contribution.
+ * @param ctx - owning UI Conversation context.
+ */
+export function registerExternalAssistantConversationNode(ctx: Context): void {
+  const match = externalAssistantDefinition.match.bind(externalAssistantDefinition)
+  ctx.uiConversation.events.register({
+    ...externalAssistantDefinition,
+    match: { 'external/assistant-message': match },
+  })
+}
