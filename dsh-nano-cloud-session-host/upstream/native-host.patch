+/** The granted external SSH terminal: literal argv/PTY, owner-only access, revoke quiescence. */
+import { homedir } from 'node:os'
+import { describe, expect, it, vi, afterEach } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { PassThrough } from 'node:stream'
+import type { ExternalWorkspaceGrant } from '@deepseek-ai/dsh-api-session-controller'
+import type { PeerId, RemoteInvocation } from '@deepseek-ai/dsh-typert-protocol'
+import type { SubprocessTerminalHandle, SubprocessSpawnSpec } from '@deepseek-ai/dsh-subprocess'
+import TypertRegistry from '@deepseek-ai/dsh-typert-registry'
+import { TerminalController, type Config, type TerminalScope } from '../src/index.ts'
+import type { WebTerminalId } from '../src/types.ts'
+
+const roots: Context[] = []
+afterEach(async () => { await Promise.all(roots.splice(0).map(ctx => ctx.fiber.dispose())) })
+
+const config: Config = {
+  shellCandidates: ['zsh', 'bash', 'sh'],
+  shell: { path: '/bin/bash', name: 'bash', args: ['--noprofile', '--norc', '-i'] },
+  maxTerminals: 2, maxAgentTerminals: 1, maxCols: 200, maxRows: 100, scrollback: 100,
+  maxBufferedBytes: 100_000, maxInputBytes: 1000, disposeGraceMs: 100,
+  unattendedTimeoutMs: 7_200_000, activityPollIntervalMs: 30_000, cleanupRetryMs: 60_000,
+}
+
+const GRANT: ExternalWorkspaceGrant = Object.freeze({
+  externalSessionId: 'external:devin:cHJvZmlsZQ:remote-1:0',
+  endpoint: 'ssh.devin.ai',
+  user: 'devin-remote-1',
+  identityFile: '/Users/test/.ssh/id_ed25519',
+  knownHostsFile: '/Users/test/.dsh/known-hosts',
+  root: '/home/ubuntu/probe',
+  terminal: true,
+})
+const FILES_ONLY: ExternalWorkspaceGrant = Object.freeze((({ terminal: _terminal, ...rest }) => ({ ...rest, externalSessionId: 'external:devin:cHJvZmlsZQ:remote-2:0' }))(GRANT))
+const ID = SessionId(GRANT.externalSessionId)
+
+function fakeHandle() {
+  const output = new PassThrough()
+  const done = Promise.withResolvers<{ exitCode: number; signal: null }>()
+  const handle = {
+    pid: 123, output, done: done.promise, write: vi.fn(async () => {}), resize: vi.fn(async () => {}),
+    inspectActivity: vi.fn<SubprocessTerminalHandle['inspectActivity']>(async () => ({ state: 'unknown', revision: 0 })),
+    inspectForeground: async () => undefined, signalForeground: async () => 123,
+    terminate: vi.fn(async () => { output.end(); done.resolve({ exitCode: 0, signal: null }) }) }
+  const checked: SubprocessTerminalHandle = handle
+  return { handle, checked }
+}
+
+async function fixture(grants: ReadonlyMap<string, ExternalWorkspaceGrant>) {
+  const ctx = new Context()
+  roots.push(ctx)
+  await ctx.plugin(TypertRegistry)
+  ctx.provide('agents', { get: () => undefined } as never)
+  const lifetimes = new Map<string, AbortController>()
+  ctx.provide('sessionController', {
+    externalSessions: {
+      grantOf: (sessionId: string) => {
+        const grant = grants.get(sessionId)
+        if (grant === undefined) return undefined
+        let lifetime = lifetimes.get(sessionId)
+        if (lifetime === undefined) { lifetime = new AbortController(); lifetimes.set(sessionId, lifetime) }
+        return { grant, entry: { view: {}, signal: lifetime.signal } }
+      },
+    },
+  } as never)
+  ctx.provide('sandboxPolicy', { defaultMode: 'danger-full-access', workspaceRoot: '/workspace', resolve: vi.fn() } as never)
+  ctx.provide('workingDirectory', { get: vi.fn(() => '/workspace'), ensure: vi.fn(async () => '/workspace') } as never)
+  const { handle, checked } = fakeHandle()
+  const subprocess = {
+    terminalEnvironment: vi.fn(async () => ({ platform: 'posix', defaultShell: '/bin/bash' })),
+    resolveExecutable: vi.fn(async (path: string) => path),
+    spawnTerminal: vi.fn(async (_spec: SubprocessSpawnSpec) => checked),
+    spawn: vi.fn(),
+  }
+  ctx.provide('subprocess', subprocess as never)
+  await ctx.plugin(TerminalController, config)
+  const controller = ctx.get('terminalController')
+  if (controller === undefined) throw new Error('terminalController service did not register')
+  return { ctx, controller, subprocess, handle, lifetimes }
+}
+
+/** Resolve the wire lookup the Gateway would run for `create`. */
+async function scopeOf(ctx: Context, id: SessionId): Promise<TerminalScope | undefined> {
+  const lookup = ctx.typert.lookups.get('terminalScope')
+  if (lookup === undefined) throw new Error('terminalScope lookup did not register')
+  return await lookup.resolve(id) as TerminalScope | undefined
+}
+
+const grants = (...grants: ExternalWorkspaceGrant[]) => new Map(grants.map(grant => [grant.externalSessionId, grant]))
+
+describe('external terminal scope', () => {
+  it('resolves only a live registration with a terminal grant; files-only and unknown ids fail', async () => {
+    const { ctx } = await fixture(grants(GRANT, FILES_ONLY))
+    const scope = await scopeOf(ctx, ID)
+    expect(scope).toMatchObject({ kind: 'external', sessionId: ID })
+    expect(await scopeOf(ctx, SessionId(FILES_ONLY.externalSessionId))).toBeUndefined()
+    expect(await scopeOf(ctx, SessionId('external:unknown'))).toBeUndefined()
+    expect(await scopeOf(ctx, SessionId('local-session'))).toBeUndefined()
+  })
+
+  it('spawns the literal ssh PTY argv with the verified root and minimal env', async () => {
+    const { ctx, controller, subprocess } = await fixture(grants(GRANT))
+    const scope = await scopeOf(ctx, ID)
+    if (scope === undefined) throw new Error('scope missing')
+    const info = await controller.create(scope, { id: 't1' as WebTerminalId, cols: 80, rows: 24 }, new AbortController().signal)
+    expect(info.cwd).toBe(GRANT.root)
+    const spec = (subprocess.spawnTerminal.mock.calls.at(-1)?.[0] ?? {}) as SubprocessSpawnSpec
+    expect(spec.argv?.[0]).toBe('/usr/bin/ssh')
+    expect(spec.argv).toEqual(expect.arrayContaining([
+      '-tt', '-F', '/dev/null', '-i', GRANT.identityFile, '-oBatchMode=yes',
+      '-oStrictHostKeyChecking=yes', `-oUserKnownHostsFile=${GRANT.knownHostsFile}`,
+      '--', `${GRANT.user}@${GRANT.endpoint}`,
+      `cd -- '${GRANT.root}' && exec /bin/bash -l`,
+    ]))
+    /* The launch directory is a safe local path; the remote root is entered
+     * by the fixed command, never by a local chdir into a foreign path. */
+    expect(spec.cwd).toBe(homedir())
+    expect(spec.env).toEqual({ LANG: 'C.UTF-8' })
+    expect(JSON.stringify(spec.argv)).not.toContain('shellPath')
+  })
+
+  it('reports the grant root and never touches the local working directory', async () => {
+    const { ctx, controller } = await fixture(grants(GRANT))
+    const scope = await scopeOf(ctx, ID)
+    if (scope === undefined) throw new Error('scope missing')
+    const env = controller.environment(scope, new AbortController().signal)
+    expect(env.cwd).toBe(GRANT.root)
+    expect(ctx.get('workingDirectory')?.get).not.toHaveBeenCalled()
+  })
+
+  it('refuses Session-keyed reads without a terminal grant and refuses non-owner principals', async () => {
+    const { controller } = await fixture(grants(GRANT, FILES_ONLY))
+    expect(() => controller.list(ID)).not.toThrow()
+    expect(() => controller.list(SessionId(FILES_ONLY.externalSessionId)))
+      .toThrowError(expect.objectContaining({ code: 'session/not-found' }))
+    const { ctx: peerCtx } = await fixture(grants(GRANT))
+    const peer = peerCtx.extend({
+      invocation: {
+        request: { namespace: 'terminal', method: 'list', args: {} },
+        service: 'terminalController',
+        peer: { id: 'p-peer' as PeerId, ctx: peerCtx, principal: { kind: 'peer' as const, id: 'intruder' }, interactions: 'answer' as const, signal: new AbortController().signal, dispose: async () => {} },
+        signal: new AbortController().signal,
+        uplink: <In>(): AsyncIterable<In> => ({ [Symbol.asyncIterator]: () => ({ next: async () => ({ done: true, value: undefined }) }) }),
+      } as unknown as RemoteInvocation,
+    })
+    expect(() => peer.terminalController.list(ID))
+      .toThrowError(expect.objectContaining({ code: 'session/not-found' }))
+  })
+
+  it('terminates live SSH children when the registration is revoked', async () => {
+    const { ctx, controller, handle, lifetimes } = await fixture(grants(GRANT))
+    const scope = await scopeOf(ctx, ID)
+    if (scope === undefined) throw new Error('scope missing')
+    await controller.create(scope, { id: 't1' as WebTerminalId, cols: 80, rows: 24 }, new AbortController().signal)
+    lifetimes.get(ID)?.abort()
+    await vi.waitFor(() => { expect(handle.terminate).toHaveBeenCalled() })
+  })
+})
