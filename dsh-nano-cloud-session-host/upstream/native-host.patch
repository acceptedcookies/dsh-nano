diff --git a/packages/api/session-controller/src/external-grants.ts b/packages/api/session-controller/src/external-grants.ts
new file mode 100644
index 0000000000..d85737b449
--- /dev/null
+++ b/packages/api/session-controller/src/external-grants.ts
@@ -0,0 +1,153 @@
+/**
+ * Host-owned deployment grants for external Session resources.
+ *
+ * A grant binds an exact opaque `external:` Session id — profile, bare remote
+ * identity, and epoch included — to one approved SSH target and root. Grants
+ * come only from the operator-owned file named by the
+ * `DSH_EXTERNAL_WORKSPACE_GRANTS` environment variable: a user-owned mode-0600
+ * JSON array. No browser, provider, or profile field can create, widen, or
+ * redirect a grant, and no secret material is stored in it.
+ */
+import { openSync, fstatSync, readFileSync, closeSync, constants } from 'node:fs'
+import { homedir } from 'node:os'
+import { normalize, isAbsolute } from 'node:path'
+
+/** One approved external workspace binding. */
+export interface ExternalWorkspaceGrant {
+  /** Exact opaque `external:` Session id this grant authorizes, epoch included. */
+  readonly externalSessionId: string
+  /** SSH endpoint hostname — no userinfo, port, or scheme. */
+  readonly endpoint: string
+  /** Remote login user. */
+  readonly user: string
+  /** Absolute path to the operator's private key file; content is never read. */
+  readonly identityFile: string
+  /** Absolute path to the deployment's known-hosts file. */
+  readonly knownHostsFile: string
+  /** Canonical remote root the file scope is confined to: a strict subdirectory, never `/` or a home. */
+  readonly root: string
+  /** Whether an interactive SSH terminal is approved for this binding. */
+  readonly terminal?: true
+}
+
+/** Literal SSH client flags every external transport uses; nothing from a browser or provider is interpolated. */
+export function sshClientArgs(grant: ExternalWorkspaceGrant): readonly string[] {
+  return [
+    '-F', '/dev/null',
+    '-i', grant.identityFile,
+    '-oBatchMode=yes',
+    '-oIdentitiesOnly=yes',
+    '-oStrictHostKeyChecking=yes',
+    `-oUserKnownHostsFile=${grant.knownHostsFile}`,
+    '-oForwardAgent=no',
+    '-oClearAllForwardings=yes',
+    '-oPermitLocalCommand=no',
+    '--',
+    `${grant.user}@${grant.endpoint}`,
+  ]
+}
+
+/** Reject a shape before it can smuggle flags, userinfo, or shell fragments. */
+function requireWord(value: unknown, name: string): string {
+  if (typeof value !== 'string' || !/^[A-Za-z0-9._-]{1,255}$/u.test(value)) {
+    throw new Error(`external workspace grant: ${name} must be a ${name === 'endpoint' ? 'hostname' : 'name'} without userinfo, port, or shell characters`)
+  }
+  return value
+}
+
+/** Absolute local paths only; the file itself is never opened by the validator. */
+function requireFilePath(value: unknown, name: string): string {
+  if (typeof value !== 'string' || !isAbsolute(value) || normalize(value) !== value || value.includes('\0')) {
+    throw new Error(`external workspace grant: ${name} must be a normalized absolute path`)
+  }
+  return value
+}
+
+/** A canonical remote root: absolute, normalized, at least two components, safe to single-quote. */
+function requireRoot(value: unknown, home: string): string {
+  if (typeof value !== 'string' || !value.startsWith('/')) {
+    throw new Error('external workspace grant: root must be an absolute remote path')
+  }
+  const root = value.replace(/\/{2,}/gu, '/')
+  if (root !== value || root.includes('..') || root.includes("'") || /[\s\\`$";&|<>()]/u.test(root)) {
+    throw new Error('external workspace grant: root must be canonical and free of shell metacharacters')
+  }
+  const depth = root.split('/').filter(component => component !== '').length
+  const dots = root.split('/').some(component => component === '.' || component === '..')
+  const remoteHome = /^\/(home|Users)\/[^/]+$/u.test(root)
+  if (root === '/' || root === home || root === '/root' || root === '/home' || remoteHome || dots || depth < 2) {
+    throw new Error('external workspace grant: root must be a strict subdirectory, never / or a home')
+  }
+  return root
+}
+
+function validateGrant(raw: unknown, index: number, home: string): ExternalWorkspaceGrant {
+  if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) {
+    throw new Error(`external workspace grant #${index} is not an object`)
+  }
+  const grant = raw as Record<string, unknown>
+  const externalSessionId = grant.externalSessionId
+  if (typeof externalSessionId !== 'string' || !externalSessionId.startsWith('external:')) {
+    throw new Error(`external workspace grant #${index}: externalSessionId must be an external: id`)
+  }
+  return Object.freeze({
+    externalSessionId,
+    endpoint: requireWord(grant.endpoint, 'endpoint'),
+    user: requireWord(grant.user, 'user'),
+    identityFile: requireFilePath(grant.identityFile, 'identityFile'),
+    knownHostsFile: requireFilePath(grant.knownHostsFile, 'knownHostsFile'),
+    root: requireRoot(grant.root, home),
+    ...(grant.terminal === true ? { terminal: true as const } : {}),
+  })
+}
+
+/**
+ * Load the deployment grant table named by `DSH_EXTERNAL_WORKSPACE_GRANTS`.
+ * @param envPath - the environment value; absent or empty means no grants.
+ * @param io - injectable fs surface for tests.
+ * @returns grants keyed by their exact external Session id.
+ * @throws Error when the file exists but is not user-owned mode 0600 or is invalid.
+ */
+export function loadExternalWorkspaceGrants(
+  envPath: string | undefined,
+  io: {
+    open: typeof openSync
+    fstat: typeof fstatSync
+    readFile: typeof readFileSync
+    close: typeof closeSync
+    uid: () => number
+    home: () => string
+  } = { open: openSync, fstat: fstatSync, readFile: readFileSync, close: closeSync, uid: () => (typeof process.getuid === 'function' ? process.getuid() : -1), home: homedir },
+): ReadonlyMap<string, ExternalWorkspaceGrant> {
+  const grants = new Map<string, ExternalWorkspaceGrant>()
+  if (envPath === undefined || envPath === '') return grants
+  if (!isAbsolute(envPath)) throw new Error('external workspace grants: DSH_EXTERNAL_WORKSPACE_GRANTS must be an absolute path')
+  /* Open with O_NOFOLLOW so a swapped symlink cannot redirect the read, then
+   * verify regular-file, mode 0600, and this uid's ownership on the same fd. */
+  const noFollow = constants.O_NOFOLLOW ?? 0
+  let fd: number
+  try {
+    fd = io.open(envPath, constants.O_RDONLY | noFollow)
+  } catch {
+    throw new Error('external workspace grants: the grants file must be a regular file, not a symlink')
+  }
+  try {
+    const stat = io.fstat(fd)
+    if (!stat.isFile() || (stat.mode & 0o777) !== 0o600 || stat.uid !== io.uid()) {
+      throw new Error('external workspace grants: the grants file must be user-owned with mode 0600')
+    }
+    const parsed: unknown = JSON.parse(io.readFile(fd, 'utf8'))
+    if (!Array.isArray(parsed)) throw new Error('external workspace grants: the grants file must contain a JSON array')
+    const home = io.home()
+    parsed.forEach((raw, index) => {
+      const grant = validateGrant(raw, index, home)
+      if (grants.has(grant.externalSessionId)) {
+        throw new Error(`external workspace grants: duplicate grant for "${grant.externalSessionId}"`)
+      }
+      grants.set(grant.externalSessionId, grant)
+    })
+    return grants
+  } finally {
+    io.close(fd)
+  }
+}
diff --git a/packages/api/session-controller/src/external-sessions.ts b/packages/api/session-controller/src/external-sessions.ts
new file mode 100644
index 0000000000..9c91b5ca11
--- /dev/null
+++ b/packages/api/session-controller/src/external-sessions.ts
@@ -0,0 +1,181 @@
+/** Registry of provider-supplied external Session wire projections.
+ *
+ * An external Session lives outside the local Session store — a carrier-owned
+ * conversation projected onto the same `session/<method>` wire surface. The
+ * `external:` namespace is reserved: ids inside it resolve only through this
+ * registry, never to persisted local Sessions, so a local row that merely
+ * collides with the prefix is withheld rather than hijacked.
+ */
+
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import { RemoteError } from '@deepseek-ai/dsh-typert-protocol'
+import type { ExternalWorkspaceGrant } from './external-grants.ts'
+import type {
+  SessionEventsPage,
+  SessionFollowFrame,
+  SessionPageRequest,
+  SessionPromptRequest,
+  SessionPromptValue,
+  SessionSummary,
+} from './types.ts'
+
+/** The `external:` namespace invariant for registered Session ids. */
+export const EXTERNAL_SESSION_PREFIX = 'external:'
+
+/**
+ * One provider-owned wire projection of an externally hosted Session.
+ *
+ * The provider answers the same shapes the native composer and Chat consume —
+ * `session.list` rows, `session.follow`, `session.events`/`page`, and
+ * `session.prompt` — without any local Session, Agent, storage, or cwd being
+ * created for it.
+ */
+export interface ExternalSessionView {
+  /**
+   * List row fields supplied by the provider; `sessionId` comes from the
+   * registration, `agentAvailable` is always `false`, and no local
+   * `cwd`/`parentSessionId`/`origin` exists for an external target.
+   */
+  readonly summary: Omit<SessionSummary, 'sessionId' | 'cwd' | 'parentSessionId' | 'origin' | 'agentAvailable'>
+  /** Opening snapshot followed by ordered durable frames, bounded by `signal`. */
+  follow(signal: AbortSignal): AsyncIterable<SessionFollowFrame>
+  /** One cold-safe message-aligned history page. */
+  events(request: SessionPageRequest, signal: AbortSignal): Promise<SessionEventsPage>
+  /** Mutating prompt admission; outcome-unknown on failure — never retried. */
+  prompt(request: SessionPromptRequest, signal: AbortSignal): Promise<SessionPromptValue>
+}
+
+/** A registered view plus the generation signal aborted when it is released. */
+export interface ExternalSessionEntry {
+  readonly view: ExternalSessionView
+  /** Aborts when this exact registration is released; merge it into every in-flight provider call. */
+  readonly signal: AbortSignal
+}
+
+interface ExternalSessionRegistered {
+  readonly view: ExternalSessionView
+  readonly controller: AbortController
+}
+
+/**
+ * Owner-side registry binding provider views to `external:` Session ids.
+ *
+ * Registration is synchronous and single-generation: the returned disposer
+ * removes exactly that entry (a re-registered replacement is not removed) and
+ * aborts its generation, which in-flight reads and prompt calls merge with the
+ * caller's signal.
+ */
+export class ExternalSessionViews {
+  /**
+   * Feature marker: this registry carries the complete native-view transport
+   * contract — owner-only routing, merged lifetime cancellation, and revoked
+   * read guards. A provider must require this marker before registering:
+   * registering against a partial host would silently open an unfiltered
+   * native Chat.
+   */
+  readonly nativeViewVersion: 1 = 1
+
+  /**
+   * Deployment grants keyed by exact external id: an opt-in binding that
+   * adds the host-owned file/preview/terminal tab providers to a view's own
+   * declaration. A grant never creates reachability by itself — the view's
+   * registration must still be live.
+   */
+  private readonly grants: ReadonlyMap<string, ExternalWorkspaceGrant>
+
+  private readonly entries = new Map<SessionId, ExternalSessionRegistered>()
+
+  /**
+   * @param grants - operator-owned deployment grants, keyed by exact external id.
+   */
+  constructor(grants: ReadonlyMap<string, ExternalWorkspaceGrant> = new Map()) {
+    this.grants = grants
+  }
+
+  /**
+   * Bind a view to an `external:` Session id.
+   * @param id - reserved `external:`-prefixed Session identity.
+   * @param view - provider wire projection for this exact target.
+   * @returns synchronous disposer releasing this exact registration.
+   * @throws Error on a non-`external:` id or a duplicate registration.
+   */
+  register(id: SessionId, view: ExternalSessionView): () => void {
+    if (!id.startsWith(EXTERNAL_SESSION_PREFIX)) {
+      throw new Error(`external Session ids must start with "${EXTERNAL_SESSION_PREFIX}" (got "${id}")`)
+    }
+    if (this.entries.has(id)) throw new Error(`external Session "${id}" is already registered`)
+    const entry: ExternalSessionRegistered = { view, controller: new AbortController() }
+    this.entries.set(id, entry)
+    let released = false
+    return () => {
+      if (released) return
+      released = true
+      if (this.entries.get(id) === entry) this.entries.delete(id)
+      entry.controller.abort()
+    }
+  }
+
+  /**
+   * Look up the live entry for a Session id.
+   * @param id - Session identity under the request's address or sessionId.
+   * @returns the registered entry, or `undefined` only for non-external ids.
+   * @throws RemoteError `session/not-found` for an unregistered `external:` id.
+   */
+  resolve(id: SessionId): ExternalSessionEntry | undefined {
+    if (!id.startsWith(EXTERNAL_SESSION_PREFIX)) return undefined
+    const entry = this.entries.get(id)
+    if (entry === undefined) {
+      throw new RemoteError('session/not-found', `session "${id}" not found`, { sessionId: id })
+    }
+    return { view: entry.view, signal: entry.controller.signal }
+  }
+
+  /**
+   * Whether this exact registration is still the live entry for `id` —
+   * the post-read guard against delivering after a mid-flight release.
+   * @param id - Session identity the entry was resolved under.
+   * @param entry - the earlier `resolve` result for that id.
+   * @returns true while the same registration still owns the id.
+   */
+  current(id: SessionId, entry: ExternalSessionEntry): boolean {
+    const found = this.entries.get(id)
+    return found !== undefined && found.view === entry.view && found.controller.signal === entry.signal
+  }
+
+  /**
+   * The approved workspace grant for a live registration, or `undefined`
+   * when the id is not registered or carries no grant — an unregistered id
+   * is refused by {@link resolve} instead of being probed here.
+   * @param id - exact `external:` Session identity, epoch included.
+   * @returns the frozen grant plus the live entry, or `undefined`.
+   */
+  grantOf(id: SessionId): { readonly grant: ExternalWorkspaceGrant; readonly entry: ExternalSessionEntry } | undefined {
+    const entry = this.entries.get(id)
+    if (entry === undefined) return undefined
+    const grant = this.grants.get(id)
+    if (grant === undefined) return undefined
+    return { grant, entry: { view: entry.view, signal: entry.controller.signal } }
+  }
+
+  /** External list rows for the owner: no local Session, Agent, or cwd. */
+  *summaries(): Iterable<SessionSummary> {
+    for (const [sessionId, entry] of this.entries) {
+      /* Host-owned enrichment: file/preview providers ride the workspace
+       * grant, the terminal provider additionally requires its opt-in flag.
+       * Provider-declared ids are kept verbatim; a session with no grant
+       * exposes only what its view declared. */
+      const declared = entry.view.summary.externalTabProviders ?? []
+      const grant = this.grants.get(sessionId)
+      const providers = grant === undefined ? declared : [
+        ...declared,
+        '@deepseek-ai/dsh-client-ui-sidebar-files/external',
+        '@deepseek-ai/dsh-client-ui-sidebar-documentpreview',
+        ...(grant.terminal === true ? ['@deepseek-ai/dsh-client-ui-sidebar-terminal/external'] : []),
+      ]
+      /* `cwd` is the navigator's root marker: a granted workspace publishes
+       * its remote root so the same native page scopes to it; reads still
+       * route only through the external WorkspaceFileScope. */
+      yield { ...entry.view.summary, sessionId, agentAvailable: false, ...(grant === undefined ? {} : { cwd: grant.root }), externalTabProviders: providers }
+    }
+  }
+}
