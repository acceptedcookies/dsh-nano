+ * local-Agent operations, and isolation from persisted local Sessions.
+ */
+
+import { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { mountAgentLoopTestDependencies, mountAgentLoopTestHarness } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { RemoteError, type PeerId, type Principal, type RemoteInvocation } from '@deepseek-ai/dsh-typert-protocol'
+import TypertRegistry from '@deepseek-ai/dsh-typert-registry'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type SessionController from '../src/index.ts'
+import type { ExternalSessionView } from '../src/external-sessions.ts'
+import type { SessionEventsPage, SessionFollowFrame, SessionRequestId } from '../src/types.ts'
+import { createSessionTestController } from './test-remote.ts'
+
+declare module '@deepseek-ai/dsh-typert-protocol' {
+  interface PrincipalMap {
+    /** Test-only non-owner caller shared by the access specs. */
+    'test-guest': { readonly kind: 'test-guest'; readonly guest: string }
+  }
+}
+
+const OWNER: Principal = { kind: 'owner' }
+const GUEST: Principal = { kind: 'test-guest', guest: 'session-controller' }
+const LOCAL = SessionId('local-session')
+const EXTERNAL = SessionId('external:devin-1')
+const EXTERNAL_2 = SessionId('external:devin-2')
+
+const owned = new Set<Context>()
+afterEach(async () => {
+  await Promise.all([...owned].map(ctx => ctx.fiber.dispose()))
+  owned.clear()
+})
+
+function fakeView(overrides: Partial<ExternalSessionView> = {}): ExternalSessionView {
+  return {
+    summary: { updatedAt: 1, running: false, blank: false },
+    follow: () => ({ [Symbol.asyncIterator]: () => ({ next: async () => ({ done: true, value: undefined }) }) }),
+    events: async () => ({ records: [], hasMore: false, cursor: 0 }) satisfies SessionEventsPage,
+    prompt: async () => ({ accepted: true }),
+    ...overrides,
+  }
+}
+
+async function harness(): Promise<{
+  readonly ctx: Context
+  readonly controller: SessionController
+  readonly local: Agent
+  readonly createLocal: (id: SessionId) => Promise<Agent>
+  /** The Context a dispatch binds for `principal` so the owner check sees the caller. */
+  readonly as: (principal: Principal, method: string) => Context
+}> {
+  const ctx = new Context()
+  owned.add(ctx)
+  await ctx.plugin(TypertRegistry)
+  await mountAgentLoopTestDependencies(ctx)
+  const loop = await mountAgentLoopTestHarness(ctx)
+  const local = await loop.create(LOCAL, {}, { cwd: '/tmp' })
+  const controller = await createSessionTestController(ctx, { defaultModelSelection: () => ({ provider: 'p', model: 'm' }), cwd: '/tmp' })
+  const as = (principal: Principal, method: string): Context => {
+    const invocation: RemoteInvocation = {
+      request: { namespace: 'session', method, args: {} },
+      service: 'sessionController',
+      peer: { id: 'external-sessions-peer' as PeerId, ctx, principal, interactions: 'answer', signal: new AbortController().signal, dispose: async () => {} },
+      signal: new AbortController().signal,
+      uplink: <In>(): AsyncIterable<In> => ({ [Symbol.asyncIterator]: () => ({ next: async () => ({ done: true, value: undefined }) }) }),
+    }
+    return ctx.extend({ invocation })
+  }
+  return { ctx, controller, local, createLocal: id => loop.create(id, {}, { cwd: '/tmp' }), as }
+}
+
+/** Asserts the existing `session/not-found` refusal — thrown synchronously
+ * for live-Agent operations or as a rejection for async reads. */
+async function expectNotFound(run: () => unknown): Promise<void> {
+  try {
+    await run()
+  } catch (error) {
+    expect(error).toBeInstanceOf(RemoteError)
+    expect((error as RemoteError<'session/not-found'>).code).toBe('session/not-found')
+    return
+  }
+  throw new Error('expected session/not-found')
+}
+
+const promptRequest = (sessionId: SessionId) => ({
+  sessionId,
+  requestId: 'req-1' as SessionRequestId,
+  mode: 'queue' as const,
+  content: [{ type: 'text' as const, text: 'hello' }],
+})
+const followRequest = (sessionId: SessionId) => ({ address: { kind: 'session' as const, sessionId } })
+const pageRequest = (sessionId: SessionId) => ({ address: { kind: 'session' as const, sessionId }, throughSeq: 0 })
+
+describe('external session views', () => {
+  it('registers, releases, and re-registers the exact entry', async () => {
+    const { controller } = await harness()
+    const view = fakeView()
+    const release = controller.externalSessions.register(EXTERNAL, view)
+    expect(controller.externalSessions.resolve(EXTERNAL)?.view).toBe(view)
+    expect(() => controller.externalSessions.register(EXTERNAL, fakeView())).toThrow(/already registered/)
+    release()
+    expect(() => controller.externalSessions.resolve(EXTERNAL)).toThrowError(RemoteError)
+    /* Releasing is generation-scoped: a stale disposer cannot drop the new entry. */
+    const second = fakeView()
+    const release2 = controller.externalSessions.register(EXTERNAL, second)
+    release()
+    expect(controller.externalSessions.resolve(EXTERNAL)?.view).toBe(second)
+    release2()
+  })
+
+  it('rejects registrations outside the external: namespace', async () => {
+    const { controller } = await harness()
+    expect(() => controller.externalSessions.register(LOCAL, fakeView())).toThrow(/external:/)
+    expect(controller.externalSessions.resolve(LOCAL)).toBeUndefined()
+  })
+
+  it('routes the owner prompt to the view with a merged signal — once, never retried', async () => {
+    const { controller, as } = await harness()
+    const prompt = vi.fn<ExternalSessionView['prompt']>(async () => ({ accepted: true }))
+    controller.externalSessions.register(EXTERNAL, fakeView({ prompt }))
+    const result = await as(OWNER, 'prompt').sessionController.prompt(promptRequest(EXTERNAL), new AbortController().signal)
+    expect(result).toEqual({ accepted: true })
+    expect(prompt).toHaveBeenCalledTimes(1)
+    expect(prompt.mock.calls[0]?.[0].sessionId).toBe(EXTERNAL)
+    expect(prompt.mock.calls[0]?.[1]).toBeInstanceOf(AbortSignal)
+  })
+
+  it('refuses steer on an external Session before the provider call', async () => {
+    const { controller, as } = await harness()
+    const prompt = vi.fn<ExternalSessionView['prompt']>(async () => ({ accepted: true }))
+    controller.externalSessions.register(EXTERNAL, fakeView({ prompt }))
+    await expect(as(OWNER, 'prompt').sessionController.prompt(
+      { ...promptRequest(EXTERNAL), mode: 'steer' as const },
+      new AbortController().signal,
+    )).rejects.toThrowError(RemoteError)
+    expect(prompt).not.toHaveBeenCalled()
+  })
+
+  it('refuses a non-owner on an external id before any provider call, even when registered', async () => {
+    const { controller, as } = await harness()
+    const prompt = vi.fn<ExternalSessionView['prompt']>(async () => ({ accepted: true }))
+    const events = vi.fn<ExternalSessionView['events']>(async () => ({ records: [], hasMore: false, cursor: 0 }))
+    controller.externalSessions.register(EXTERNAL, fakeView({ prompt, events }))
+    const signal = new AbortController().signal
+    await expectNotFound(() => as(GUEST, 'prompt').sessionController.prompt(promptRequest(EXTERNAL), signal))
+    await expectNotFound(() => as(GUEST, 'page').sessionController.page(pageRequest(EXTERNAL), signal))
+    expect(prompt).not.toHaveBeenCalled()
+    expect(events).not.toHaveBeenCalled()
+  })
+
+  it('throws session/not-found for an unregistered external id instead of touching the local store', async () => {
+    const { as } = await harness()
+    const signal = new AbortController().signal
+    await expectNotFound(() => as(OWNER, 'prompt').sessionController.prompt(promptRequest(SessionId('external:gone')), signal))
+    await expectNotFound(() => as(OWNER, 'cancel').sessionController.cancel({ sessionId: EXTERNAL }))
+    await expectNotFound(() => as(OWNER, 'updateQueue').sessionController.updateQueue({
+      sessionId: EXTERNAL, itemId: 'item-1' as never, action: { kind: 'remove' },
+    }))
+  })
+
+  it('follows the provider stream for the owner and ends it on release', async () => {
+    const { controller, as } = await harness()
+    const frame: SessionFollowFrame = { type: 'event', event: { type: 'user/message', seq: 1, time: 0, data: {} } }
+    const view = fakeView({
+      follow: signal => (async function* (): AsyncGenerator<SessionFollowFrame> {
+        signal.throwIfAborted()
+        yield frame
+        /* Provider contract: the view honors the merged signal — including an
+         * abort that fired before this point — and settles when it fires. */
+        await new Promise((_, reject) => {
+          if (signal.aborted) reject(signal.reason)
+          else signal.addEventListener('abort', () => reject(signal.reason))
+        })
+      })(),
+    })
+    const release = controller.externalSessions.register(EXTERNAL, view)
+    const stream = as(OWNER, 'follow').sessionController.follow(followRequest(EXTERNAL), new AbortController().signal)
+    const iterator = stream[Symbol.asyncIterator]()
+    expect((await iterator.next()).value).toEqual(frame)
+    release()
+    /* The released generation ends the stream; a frame completing after
+     * revoke is reported not-found rather than delivered. */
+    await expect(iterator.next()).rejects.toBeDefined()
+    /* Re-registering the id gives the new registration a live follow. */
+    controller.externalSessions.register(EXTERNAL, view)
+    const revived = as(OWNER, 'follow').sessionController.follow(followRequest(EXTERNAL), new AbortController().signal)
+    expect((await revived[Symbol.asyncIterator]().next()).value).toEqual(frame)
+    await iterator.return?.()
+  })
+
+  it('rejects reads that complete after the registration is released', async () => {
+    const { controller, as } = await harness()
+    let release: (() => void) | undefined
+    const view = fakeView({
+      events: async () => {
+        release?.()
+        return { records: [], hasMore: false, cursor: 0 }
+      },
+    })
+    release = controller.externalSessions.register(EXTERNAL, view)
+    await expectNotFound(() => as(OWNER, 'events').sessionController.events(pageRequest(EXTERNAL), new AbortController().signal))
+  })
+
+  it('keeps separate targets on separate views and never routes old ids into the registry', async () => {
+    const { controller, as } = await harness()
+    const one = vi.fn<ExternalSessionView['prompt']>(async () => ({ accepted: true }))
+    const two = vi.fn<ExternalSessionView['prompt']>(async () => ({ accepted: true }))
+    controller.externalSessions.register(EXTERNAL, fakeView({ prompt: one }))
+    controller.externalSessions.register(EXTERNAL_2, fakeView({ prompt: two }))
+    const signal = new AbortController().signal
+    await as(OWNER, 'prompt').sessionController.prompt(promptRequest(EXTERNAL), signal)
+    await as(OWNER, 'prompt').sessionController.prompt(promptRequest(EXTERNAL_2), signal)
+    expect(one).toHaveBeenCalledTimes(1)
+    expect(two).toHaveBeenCalledTimes(1)
+    /* A persisted local Session with a plain id never reaches the registry. */
+    const resolve = vi.spyOn(controller.externalSessions, 'resolve')
+    try {
+      await as(OWNER, 'prompt').sessionController.prompt(promptRequest(LOCAL), signal)
+      const externalCalls = resolve.mock.calls.filter(([id]) => String(id).startsWith('external:'))
+      expect(externalCalls).toEqual([])
+    } finally {
+      resolve.mockRestore()
+    }
+  })
+
+  it('refuses every local-path and live-Agent operation on external ids', async () => {
+    const { controller, as } = await harness()
+    controller.externalSessions.register(EXTERNAL, fakeView())
+    const signal = new AbortController().signal
+    const guest = as(OWNER, 'x').sessionController
+    await expectNotFound(() => guest.cancel({ sessionId: EXTERNAL }))
+    await expectNotFound(() => guest.updateQueue({ sessionId: EXTERNAL, itemId: 'i-1' as never, action: { kind: 'remove' } }))
+    await expectNotFound(() => guest.rename({ sessionId: EXTERNAL, title: 'x' }))
+    await expectNotFound(() => guest.fork({ sessionId: EXTERNAL }))
+    await expectNotFound(() => guest.selectModel({ sessionId: EXTERNAL, provider: 'p', model: 'm' }))
+    await expectNotFound(() => guest.attachment({ sessionId: EXTERNAL, attachment: {} as never }))
+    await expectNotFound(() => guest.state({ sessionId: EXTERNAL }, signal))
+    await expectNotFound(() => guest.wait({ sessionId: EXTERNAL, timeoutMs: 1 }, signal))
+    await expectNotFound(() => guest.observeState({ sessionId: EXTERNAL }, signal))
+    await expectNotFound(() => guest.observeProjections({ sessionId: EXTERNAL }, signal))
+    await expectNotFound(() => guest.observeEvent({ address: { kind: 'session', sessionId: EXTERNAL } }, signal))
+    await expectNotFound(() => controller.resolveAgent(EXTERNAL))
+    /* An external id offered to create must not mint a local Session. */
+    await expectNotFound(() => guest.create({ sessionId: EXTERNAL }))
+    /* A subagent Address with either end in the namespace is refused. */
+    const localId = SessionId('local-session')
+    for (const address of [
+      { kind: 'subagent' as const, parentSessionId: EXTERNAL, childSessionId: localId, mode: 'unknown' as const },
+      { kind: 'subagent' as const, parentSessionId: localId, childSessionId: EXTERNAL, mode: 'unknown' as const },
+    ]) {
+      await expectNotFound(() => guest.page({ address, throughSeq: 0 }, signal))
+      await expectNotFound(() => guest.events({ address, throughSeq: 0 }, signal))
+      expect(() => guest.follow({ address }, signal)).toThrowError(RemoteError)
+      expect(() => guest.observeEvent({ address }, signal)).toThrowError(RemoteError)
+    }
+    await expect(as(OWNER, 'projections').sessionController.projections({ sessionId: EXTERNAL }, signal))
+      .resolves.toBeNull()
+  })
+
+  it('withholds a local row colliding with the external: namespace from list', async () => {
+    const { as, createLocal } = await harness()
+    /* A persisted local Session minted inside the reserved namespace is
+     * withheld from every caller's list, never hijacked by the registry. */
+    const collision = SessionId('external:local-collision')
+    const signal = new AbortController().signal
+    await createLocal(collision)
+    const owner = await as(OWNER, 'list').sessionController.list({}, signal)
+    expect(owner.items.some(item => item.sessionId === collision)).toBe(false)
+    const guest = await as(GUEST, 'list').sessionController.list({}, signal)
+    expect(guest.items.some(item => item.sessionId === collision)).toBe(false)
+    /* The collision is withheld from routing too: resolving it reports not-found. */
+    await expectNotFound(() => as(OWNER, 'prompt').sessionController.prompt(promptRequest(collision), signal))
+  })
+
+  it('projects externalTabProviders from the view summary into the owner list row', async () => {
+    const { controller, as } = await harness()
+    const providers = ['@acme/cloud-files', '@acme/cloud-attachments']
+    controller.externalSessions.register(EXTERNAL, fakeView({ summary: { updatedAt: 1, running: false, blank: false, externalTabProviders: providers } }))
+    const owner = await as(OWNER, 'list').sessionController.list({}, new AbortController().signal)
+    expect(owner.items.find(item => item.sessionId === EXTERNAL)?.externalTabProviders).toEqual(providers)
+  })
+
+  it('lists external rows only for the owner, with agentAvailable false and no cwd', async () => {
+    const { controller, as, local } = await harness()
+    controller.externalSessions.register(EXTERNAL, fakeView())
+    const signal = new AbortController().signal
+    const owner = await as(OWNER, 'list').sessionController.list({}, signal)
+    const external = owner.items.find(item => item.sessionId === EXTERNAL)
+    expect(external).toBeDefined()
+    expect(external?.agentAvailable).toBe(false)
+    expect(external?.cwd).toBeUndefined()
+    const guest = await as(GUEST, 'list').sessionController.list({}, signal)
+    expect(guest.items.some(item => item.sessionId === EXTERNAL)).toBe(false)
+    void local
+  })
+})
