@@ -0,0 +1,202 @@
+// @vitest-environment jsdom
+/**
+ * External Sessions in the right Sidebar: only the builtin guide and the
+ * `externalTabProviders` from the Host summary may place, appear in the
+ * picker, or contribute guide entries; kinds, forged ids, and persisted
+ * layouts are not trusted, and local Sessions are unchanged.
+ */
+
+import { Context } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { createSidebarRightController, type SidebarRightExternalTabs } from '../src/client/service.ts'
+import { createSidebarRightStore } from '../src/client/stores.ts'
+import { SidebarRightTabRegistry } from '../src/client/tab-registry.ts'
+import { GUIDE_ID, guideDefinition } from '../src/client/tabs/guide/definition.ts'
+import { writeSidebarLayout } from '../src/client/persistence.ts'
+import { EMPTY_HISTORY, type LayoutState } from '@deepseek-ai/dsh-client-ui-dockkit'
+
+const LOCAL = 's-local' as SessionId
+const EXTERNAL = 'external:devin-1' as SessionId
+const CLOUD_FILES = '@acme/cloud-files'
+const t = ((key: string) => key) as Parameters<typeof guideDefinition>[0]
+
+function harness(providers: readonly string[] | undefined) {
+  const tabs = new SidebarRightTabRegistry(new Context())
+  tabs.register(guideDefinition(t))
+  tabs.register({
+    id: CLOUD_FILES, kind: 'cloud-files', priority: 'builtin',
+    guide: [{ id: 'files', order: 1, title: () => 'Cloud files' }],
+    title: () => 'Cloud files',
+  })
+  tabs.register({
+    id: 'test/text', kind: 'text', patterns: ['dsh-resource://file/**'], priority: 'fallback',
+    guide: [{ id: 'text', order: 2, title: () => 'Local file' }],
+    title: address => address.slice(address.lastIndexOf('/') + 1),
+  })
+  const externalTabs: SidebarRightExternalTabs = {
+    providers: sessionId => sessionId.startsWith('external:') ? providers : undefined,
+    subscribe: () => () => {},
+  }
+  const pin = vi.fn<(address: string, signal: AbortSignal) => void>()
+  const { controller, adopt, show, measure } = createSidebarRightController(tabs, pin, {
+    autoFullscreen: () => false,
+    openWithFocus: (_sessionId, open) => { open() },
+    closeWithFocus: (_sessionId, _paneId, close) => { close() },
+  }, externalTabs)
+  const store = createSidebarRightStore(() => ({ kind: 'guide', title: 'seed' }))
+  const localInstance = store.create(LOCAL)
+  const externalInstance = store.create(EXTERNAL)
+  const unadoptLocal = adopt(LOCAL, localInstance)
+  const unadoptExternal = adopt(EXTERNAL, externalInstance)
+  return {
+    tabs, controller, pin, localInstance, externalInstance,
+    showLocal: () => { show(LOCAL); measure(LOCAL, () => true) },
+    showExternal: () => { show(EXTERNAL); measure(EXTERNAL, () => true) },
+    expandLocal: () => { show(LOCAL); localInstance.actions.setExpanded(LOCAL, true) },
+    expandExternal: () => { show(EXTERNAL); externalInstance.actions.setExpanded(EXTERNAL, true) },
+    layout: (sessionId: SessionId, instance = externalInstance): LayoutState => {
+      const surface = instance.getSnapshot().bySession[sessionId]
+      if (surface === undefined) throw new Error('expected a surface')
+      return surface.layout
+    },
+    dispose: () => { unadoptLocal(); unadoptExternal(); show(undefined) },
+  }
+}
+
+beforeEach(() => {
+  localStorage.clear()
+})
+
+describe('external session tabs', () => {
+  it('leaves local Sessions unrestricted', () => {
+    const h = harness(['never-admitted'])
+    try {
+      h.expandLocal()
+      h.controller.openTab('text')
+      h.controller.openResource('dsh-resource://file/session/s-local/notes.md', { kind: 'text' })
+      expect(Object.keys(h.layout(LOCAL, h.localInstance).tabs).length).toBeGreaterThan(0)
+    } finally { h.dispose() }
+  })
+
+  it('admits only the summary-declared providers plus the builtin guide', () => {
+    const h = harness([CLOUD_FILES])
+    try {
+      h.expandExternal()
+      h.controller.openTab('cloud-files')
+      h.controller.openTab('guide')
+      const kinds = Object.values(h.layout(EXTERNAL).tabs).map(tab => tab.kind)
+      expect(kinds).toContain('cloud-files')
+      /* Local handlers — text/file, a terminal kind, an editor kind — are not admitted. */
+      expect(() => h.controller.openTab('text')).toThrowError(/not admitted/)
+      expect(() => h.controller.openResource('dsh-resource://file/session/external:devin-1/a.md', { kind: 'text' }))
+        .toThrowError(/not admitted/)
+      /* Refused opens pinned nothing: only the admitted tabs above were held. */
+      expect(h.pin.mock.calls.map(([address]) => address)).toEqual(['sidebar://guide', 'sidebar://cloud-files'])
+    } finally { h.dispose() }
+  })
+
+  it('refuses a resource claim scoped to a different Session before pinning', () => {
+    const h = harness([CLOUD_FILES, 'test/text'])
+    try {
+      h.expandExternal()
+      /* An admitted kind still cannot carry a cloud page onto a different
+       * external target, nor pull a local address into an external page. */
+      expect(() => h.controller.openResource('dsh-resource://file/session/external:devin-2/a.md', { kind: 'text' }))
+        .toThrowError(/scoped to/)
+      expect(() => h.controller.openResource('dsh-resource://file/session/s-local/a.md', { kind: 'text' }))
+        .toThrowError(/scoped to/)
+      const before = h.pin.mock.calls.length
+      h.controller.openResource('dsh-resource://file/session/external:devin-1/a.md', { kind: 'text' })
+      expect(h.pin.mock.calls.length).toBeGreaterThan(before)
+      const kinds = Object.values(h.layout(EXTERNAL).tabs).map(tab => tab.kind)
+      expect(kinds).toContain('text')
+      /* The same crossing on a local Session is refused as well. */
+      h.expandLocal()
+      expect(() => h.controller.openResource('dsh-resource://file/session/external:devin-1/a.md', { kind: 'text' }))
+        .toThrowError(/scoped to/)
+      h.controller.openResource('dsh-resource://file/session/s-local/b.md', { kind: 'text' })
+      const localKinds = Object.values(h.layout(LOCAL, h.localInstance).tabs).map(tab => tab.kind)
+      expect(localKinds).toContain('text')
+    } finally { h.dispose() }
+  })
+
+  it('refuses an externalOnly type on a local Session and admits it on a declared external one', () => {
+    const h = harness(['test/external-only'])
+    try {
+      h.tabs.register({
+        id: 'test/external-only', kind: 'cloud-attachments', externalOnly: true,
+        guide: [{ id: 'attachments', order: 3, title: () => 'Attachments' }],
+        title: () => 'Attachments',
+      })
+      h.expandLocal()
+      h.pin.mockClear()
+      expect(() => h.controller.openTab('cloud-attachments')).toThrowError(/external-only/)
+      expect(h.pin).not.toHaveBeenCalled()
+      h.expandExternal()
+      h.controller.openTab('cloud-attachments')
+      expect(Object.values(h.layout(EXTERNAL).tabs).map(tab => tab.kind)).toContain('cloud-attachments')
+      /* A local picker/guide snapshot never offers the external-only type. */
+      const localGuide = h.controller.guideEntries(LOCAL).getSnapshot()
+      expect(localGuide.some(box => box.providerId === 'test/external-only')).toBe(false)
+    } finally { h.dispose() }
+  })
+
+  it('refuses a forged or merely-registered kind and an unadmitted resource claim before pinning', () => {
+    const h = harness([])
+    try {
+      h.expandExternal()
+      /* No descriptor at all: only the guide exists for this Session. */
+      expect(() => h.controller.openTab('kitesurf')).toThrowError(/no tab type is registered|not admitted/)
+      expect(() => h.controller.openTab('cloud-files')).toThrowError(/not admitted/)
+      /* A resource whose glob matches a local handler is still refused. */
+      expect(() => h.controller.openResource('dsh-resource://file/session/x/a.md')).toThrowError(/not admitted/)
+      /* Only the admitted guide seed pinned anything — refused claims pinned none. */
+      expect(h.pin.mock.calls.map(([address]) => address)).toEqual(['sidebar://guide'])
+      /* Guide remains openable. */
+      h.controller.openTab('guide')
+      expect(Object.values(h.layout(EXTERNAL).tabs).some(tab => tab.id === GUIDE_ID || tab.kind === 'guide')).toBe(true)
+    } finally { h.dispose() }
+  })
+
+  it('filters the guide and picker to admitted providers, individually per Session', () => {
+    const h = harness([CLOUD_FILES])
+    try {
+      const externalSource = h.controller.guideEntries(EXTERNAL)
+      const externalEntries = externalSource.getSnapshot()
+      expect(externalEntries.map(entry => entry.providerId)).toEqual([CLOUD_FILES])
+      const localEntries = h.controller.guideEntries(LOCAL).getSnapshot()
+      expect(localEntries.length).toBeGreaterThan(externalEntries.length)
+      const externalTypes = h.controller.tabTypes(EXTERNAL).getSnapshot().map(d => d.id)
+      expect(externalTypes.sort()).toEqual([GUIDE_ID, CLOUD_FILES].sort())
+      const localTypes = h.controller.tabTypes(LOCAL).getSnapshot()
+      expect(localTypes.length).toBeGreaterThan(externalTypes.length)
+      /* Snapshot identity is stable while the registry revision and providers are unchanged. */
+      expect(externalSource.getSnapshot()).toBe(externalEntries)
+    } finally { h.dispose() }
+  })
+
+  it('runs a transient layout: persisted tabs, titles and shortcuts never restore', () => {
+    /* Seed a saved external layout as if a stale client wrote it. */
+    writeSidebarLayout(EXTERNAL, {
+      layout: {
+        nodes: {
+          pane1: { kind: 'pane', id: 'pane1', host: 'dock', tabs: ['tab1'], activeTabId: 'tab1' },
+        },
+        tabs: { tab1: { id: 'tab1', kind: 'text', contentId: 'dsh-resource://file/session/x/evil.md', title: 'forged' } },
+        rootId: 'pane1', floats: [], activePaneId: 'pane1', expanded: true, mode: 'push',
+      } as unknown as LayoutState,
+      minted: 9,
+      history: EMPTY_HISTORY,
+    } as never)
+    const store = createSidebarRightStore(() => ({ kind: 'guide', title: 'seed' }))
+    const instance = store.create(EXTERNAL)
+    instance.actions.open(EXTERNAL)
+    /* The stale record never restored: no forged tab, title, or shortcut. */
+    expect(instance.getSnapshot().bySession[EXTERNAL]?.layout.tabs).toEqual({})
+    /* Clearing it after creation and committing again still writes nothing back. */
+    localStorage.removeItem(`dsh.sidebar-right.v1.${EXTERNAL}`)
+    instance.actions.setExpanded(EXTERNAL, true)
+    expect(localStorage.getItem(`dsh.sidebar-right.v1.${EXTERNAL}`)).toBeNull()
+  })
+})
