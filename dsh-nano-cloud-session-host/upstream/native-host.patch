@@ -0,0 +1,103 @@
+/** Deployment grant loading, validation, and grant-bound summary enrichment. */
+import { describe, expect, it } from 'vitest'
+import { mkdtempSync, writeFileSync, chmodSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { ExternalSessionViews, type ExternalSessionView } from '../src/external-sessions.ts'
+import { loadExternalWorkspaceGrants, sshClientArgs, type ExternalWorkspaceGrant } from '../src/external-grants.ts'
+
+const GRANT: ExternalWorkspaceGrant = Object.freeze({
+  externalSessionId: 'external:devin:cHJvZmlsZQ:remote-1:0',
+  endpoint: 'ssh.devin.ai',
+  user: 'devin-remote-1',
+  identityFile: '/Users/test/.ssh/id_ed25519',
+  knownHostsFile: '/Users/test/.dsh/known-hosts',
+  root: '/home/ubuntu/probe',
+  terminal: true,
+})
+const ID = SessionId(GRANT.externalSessionId)
+
+function view(): ExternalSessionView {
+  const page = { records: [], hasMore: false, cursor: -1 }
+  return {
+    summary: { title: 'external' } as never,
+    follow: async function* () {},
+    events: async () => page as never,
+    prompt: async () => ({ kind: 'prompt-response', requestId: 'r', response: {} }) as never,
+  }
+}
+
+function grantsFile(entries: unknown[], mode = 0o600): string {
+  const dir = mkdtempSync(join(tmpdir(), 'dsh-grants-'))
+  const path = join(dir, 'grants.json')
+  writeFileSync(path, JSON.stringify(entries))
+  chmodSync(path, mode)
+  return path
+}
+
+describe('loadExternalWorkspaceGrants', () => {
+  it('returns an empty table without the environment path and rejects a non-0600 file', () => {
+    expect(loadExternalWorkspaceGrants(undefined).size).toBe(0)
+    expect(loadExternalWorkspaceGrants('').size).toBe(0)
+    expect(() => loadExternalWorkspaceGrants('relative/grants.json')).toThrow(/absolute/)
+    expect(() => loadExternalWorkspaceGrants(grantsFile([GRANT], 0o644))).toThrow(/0600/)
+  })
+
+  it('validates each field and keys grants by their exact external id', () => {
+    const loaded = loadExternalWorkspaceGrants(grantsFile([GRANT]))
+    expect(loaded.get(GRANT.externalSessionId)).toEqual(GRANT)
+    expect(() => loadExternalWorkspaceGrants(grantsFile([{ ...GRANT, endpoint: 'user@evil' }]))).toThrow()
+    expect(() => loadExternalWorkspaceGrants(grantsFile([{ ...GRANT, root: '/' }]))).toThrow(/strict subdirectory/)
+    expect(() => loadExternalWorkspaceGrants(grantsFile([{ ...GRANT, root: '/home/ubuntu' }]))).toThrow(/strict subdirectory/)
+    expect(() => loadExternalWorkspaceGrants(grantsFile([{ ...GRANT, root: "/home/ubuntu/it's" }]))).toThrow()
+    expect(() => loadExternalWorkspaceGrants(grantsFile([{ ...GRANT, externalSessionId: 'local-1' }]))).toThrow(/external:/)
+    expect(() => loadExternalWorkspaceGrants(grantsFile([GRANT, GRANT]))).toThrow(/duplicate/)
+    expect(() => loadExternalWorkspaceGrants(grantsFile({ nope: true } as never))).toThrow(/array/)
+  })
+
+  it('builds literal strict client flags with no secret or browser input', () => {
+    const argv = sshClientArgs(GRANT)
+    expect(argv).toEqual([
+      '-F', '/dev/null', '-i', GRANT.identityFile, '-oBatchMode=yes', '-oIdentitiesOnly=yes',
+      '-oStrictHostKeyChecking=yes', `-oUserKnownHostsFile=${GRANT.knownHostsFile}`,
+      '-oForwardAgent=no', '-oClearAllForwardings=yes', '-oPermitLocalCommand=no', '--',
+      'devin-remote-1@ssh.devin.ai',
+    ])
+  })
+})
+
+describe('grant binding on live registrations', () => {
+  it('enriches summaries only for a granted, registered id and withdraws on release', () => {
+    const views = new ExternalSessionViews(new Map([[GRANT.externalSessionId, GRANT]]))
+    const release = views.register(ID, view())
+    const rows = [...views.summaries()]
+    expect(rows.at(0)?.externalTabProviders).toEqual([
+      '@deepseek-ai/dsh-client-ui-sidebar-files/external',
+      '@deepseek-ai/dsh-client-ui-sidebar-documentpreview',
+      '@deepseek-ai/dsh-client-ui-sidebar-terminal/external',
+    ])
+    expect(views.grantOf(ID)?.grant).toEqual(GRANT)
+    release()
+    expect(views.grantOf(ID)).toBeUndefined()
+    expect([...views.summaries()]).toEqual([])
+  })
+
+  it('keeps declared providers for ungranted sessions and hides terminal when not opted in', () => {
+    const filesOnly = Object.freeze((({ terminal: _terminal, ...rest }) => ({ ...rest, externalSessionId: 'external:devin:cHJvZmlsZQ:remote-2:0' }))(GRANT))
+    const noGrant = SessionId('external:devin:cHJvZmlsZQ:remote-3:0')
+    const views = new ExternalSessionViews(new Map([
+      [GRANT.externalSessionId, GRANT],
+      [SessionId(filesOnly.externalSessionId), filesOnly],
+    ]))
+    const declared = view()
+    ;(declared.summary as unknown as { externalTabProviders?: string[] }).externalTabProviders = ['nano-cloud-session.attachments']
+    views.register(noGrant, declared)
+    views.register(SessionId(filesOnly.externalSessionId), view())
+    const byId = new Map([...views.summaries()].map(row => [row.sessionId, row.externalTabProviders]))
+    expect(byId.get(noGrant)).toEqual(['nano-cloud-session.attachments'])
+    expect(byId.get(SessionId(filesOnly.externalSessionId))).not.toContain('@deepseek-ai/dsh-client-ui-sidebar-terminal/external')
+    expect(byId.get(SessionId(filesOnly.externalSessionId))).toContain('@deepseek-ai/dsh-client-ui-sidebar-files/external')
+    expect(views.grantOf(noGrant)).toBeUndefined()
+  })
+})
