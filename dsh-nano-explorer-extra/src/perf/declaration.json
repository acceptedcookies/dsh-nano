{
  "schema": "dnpr.declaration/1",
  "plugin": "nano-explorer-extra",
  "keys": {
    "spans": [
      "apply-status",
      "list-level",
      "dir-status",
      "git-refresh",
      "stats-count"
    ],
    "tracks": [
      {
        "name": "card-shape",
        "kind": "mutation"
      },
      {
        "name": "card-follow",
        "kind": "raf"
      },
      {
        "name": "card-wake",
        "kind": "mutation"
      },
      {
        "name": "git-poll",
        "kind": "interval"
      }
    ],
    "usage": [
      "dialog-open",
      "menu-open",
      "files-expand"
    ],
    "hostSpans": [
      "git-status",
      "stats"
    ]
  },
  "buckets": [
    {
      "attr": "data-nxe",
      "bucket": "files-row"
    }
  ],
  "contract": [
    "dnee.status",
    "dnee.commit",
    "dnee.pull",
    "dnee.fetch",
    "dnee.push",
    "dnee.remote",
    "dnee.author",
    "dnee.ssh-key",
    "dnee.checkout",
    "dnee.create-file",
    "dnee.create-folder",
    "dnee.rename",
    "dnee.move",
    "dnee.delete",
    "dnee.ignored",
    "dnee.list",
    "dnee.perf-review.host",
    "dnee.read"
  ],
  "scenarios": [
    {
      "id": "files-expand",
      "driver": "lab/drivers/files-expand.mjs"
    }
  ],
  "budgets": [
    {
      "id": "track.card-follow.callbacks",
      "scenario": "idle-10s",
      "subject": "hand.tracks.card-follow.callbacks",
      "gate": "hard",
      "rule": {
        "op": "eq",
        "limit": 0
      }
    },
    {
      "id": "track.card-follow.live",
      "scenario": "idle-10s",
      "subject": "hand.tracks.card-follow.live",
      "gate": "hard",
      "rule": {
        "op": "eq",
        "limit": 0
      }
    },
    {
      "id": "track.git-poll.live",
      "scenario": "idle-10s",
      "subject": "hand.tracks.git-poll.live",
      "gate": "hard",
      "rule": {
        "op": "min",
        "limit": 1
      }
    },
    {
      "id": "track.git-poll.callbacks",
      "scenario": "idle-10s",
      "subject": "hand.tracks.git-poll.callbacks",
      "gate": "audit",
      "rule": {
        "op": "relBaseline",
        "factor": 2,
        "floor": 1,
        "initial": 1
      }
    },
    {
      "id": "track.card-wake.callbacks",
      "scenario": "idle-10s",
      "subject": "hand.tracks.card-wake.callbacks",
      "gate": "hard",
      "rule": {
        "op": "relBaseline",
        "factor": 2,
        "floor": 40,
        "initial": 40
      }
    },
    {
      "id": "track.card-wake.live",
      "scenario": "idle-10s",
      "subject": "hand.tracks.card-wake.live",
      "gate": "hard",
      "rule": {
        "op": "max",
        "limit": 4
      }
    },
    {
      "id": "track.card-shape.callbacks",
      "scenario": "idle-10s",
      "subject": "hand.tracks.card-shape.callbacks",
      "gate": "audit",
      "rule": {
        "op": "relBaseline",
        "factor": 2,
        "floor": 1,
        "initial": 1
      }
    }
  ]
}
