{
  "name": "dsh-nano-local-sandbox",
  "version": "0.1.0",
  "description": "Environment-owned local sandboxes and terminals with explicit object selection on macOS.",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./index.js",
  "scripts": {
    "test": "node --test test/*.mjs test/contracts/*.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "AGENTS.md",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "src/host",
    "profiles/kitesurf",
    "profiles/terminal",
    "lib/route-guard.js",
    "lib/bindings.js",
    "lib/perf-review-host.js"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "dsh-host-route-guard": "file:../packages/dsh-host-route-guard",
    "dsh-performance-review": "file:../packages/dsh-performance-review",
    "esbuild": "0.25.0"
  },
  "dependencies": {
    "ws": "8.21.3"
  }
}
