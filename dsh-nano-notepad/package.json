{
  "name": "dsh-nano-notepad",
  "version": "0.1.1",
  "description": "A floating Markdown notepad. Files, history, and images stay in this browser.",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./index.js",
  "scripts": {
    "build": "node scripts/build-client.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "AGENTS.md",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "lib/client.js",
    "lib/perf-review-host.js",
    "lib/route-guard.js",
    "lib/route-table.js",
    "lib/s3-sync-host.js"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "devDependencies": {
    "dsh-host-route-guard": "file:../packages/dsh-host-route-guard",
    "dsh-html-policy": "file:../packages/dsh-html-policy",
    "dsh-nano-ui": "file:../packages/dsh-nano-ui",
    "dsh-performance-review": "file:../packages/dsh-performance-review",
    "dsh-remote-data-schema": "file:../packages/dsh-remote-data-schema",
    "dsh-s3-client": "file:../packages/dsh-s3-client",
    "esbuild": "0.25.0"
  }
}
