{
  "name": "dsh-nano-terminal",
  "version": "0.1.0",
  "description": "WASM-core terminal for dsh: split panes, local/MCP/isolate lanes, MCP control plane",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "AGENTS.md",
    "cordis.patch.yml",
    "icon.svg",
    "lib"
  ],
  "scripts": {
    "build:rust": "bash scripts/build-rust.sh",
    "build": "node scripts/build-client.mjs",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
