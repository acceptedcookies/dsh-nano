  "title": "dsh-nano-terminal MCP control plane",
  "version": "0.2.0",
  "description": "Canonical contract for term.* tools, error kinds and term.* events. The mcp.js tool table is generated from this document; /term slash subcommands and ws-v2 frames implement the same semantics. Contract only grows — never rename or remove a method, kind, or event type."
 },
 "x-errorKinds": [
  "not_found",
  "blocked",
  "finished",
  "live",
  "unavailable",
  "spawn_failed",
  "conflict",
  "status_mismatch",
  "name_taken",
  "needs_target",
  "incompatible",
  "limit",
  "invalid"
 ],
 "x-events": [
  "created",
  "lost",
  "finished",
  "removed",
  "status",
  "turn",
  "title",
  "labels",
  "size",
  "restarted",
  "heartbeat",
  "missed",
  "message"
 ],
 "x-address": {
  "type": "string",
  "minLength": 1,
  "description": "Terminal addressable by id, by name, or by addr '<lane>/<name|short6>'. All three resolve through the same registry."
 },
