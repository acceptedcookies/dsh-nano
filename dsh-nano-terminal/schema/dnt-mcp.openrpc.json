    "type": "object",
    "properties": {
     "lane": {
      "type": "string",
      "enum": [
       "local"
      ],
      "default": "local",
      "x-advertise-note": "CF1115/P3-02/F20.2 广告精确对账: lane only `local` — this host's MCP create backs a local PTY; `mcp`/`isolate` are no longer advertised (client connect-mode != backend lane enum). Non-local requests are rejected `incompatible` in mcp.js."
     },
     "name": {
      "type": "string",
      "description": "addressable name; unique per registry"
     },
     "parent": {
      "type": "string",
      "description": "parent terminal addr — notes fan-in and die_with_parent"
     },
     "keep": {
      "type": "boolean",
      "description": "respawn a shell when the program is lost; never reruns the command"
     },
     "labels": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "sessionId": {
      "type": "string",
      "description": "owning dsh session (cwd + scoping)"
     },
     "shell": {
      "type": "string"
     },
     "args": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "cwd": {
      "type": "string"
     },
     "cols": {
      "type": "integer"
     },
     "rows": {
      "type": "integer"
     },
     "title": {
      "type": "string"
     }
    },
    "additionalProperties": false
   },
   "result": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "addr": {
      "type": "string"
     },
     "lane": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "attach": {
      "type": "object"
     },
     "ctx": {
      "type": [
       "string",
       "null"
      ]
     },
     "labels": {
      "type": "object"
     }
    }
   },
   "errors": [
    "name_taken",
    "spawn_failed",
