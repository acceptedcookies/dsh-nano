{
  "schema": "dnpr.declaration/1",
  "plugin": "nano-terminal",
  "keys": {
    "spans": [
      "dnt-paint",
      "dnt-attach",
      "dnt-echo",
      "dnt-layout"
    ],
    "tracks": [
      { "name": "dnt-cells", "kind": "counter" },
      { "name": "dnt-panes", "kind": "live" }
    ],
    "usage": [
      "dnt-ws-in-bytes",
      "dnt-ws-in-msgs",
      "dnt-ws-out-bytes",
      "dnt-out-bytes",
      "dnt-frames-skipped"
    ],
    "hostSpans": [
      "dnt-spawn",
      "dnt-attach",
      "dnt-pipe-broadcast",
      "dnt-gate",
      "dnt-input",
      "dnt-agent-send"
    ]
  },
  "buckets": [
    { "attr": "data-dnt-pane", "bucket": "nano-term-pane" },
    { "attr": "data-dnt-root", "bucket": "nano-term" }
  ],
  "contract": [
    "dnt.mcp",
    "dnt.sessions",
    "dnt.events",
    "dnt.health",
    "dnt.session.close",
    "dnt.stream",
    "dnt.perf-review.host"
  ],
  "scenarios": [
    { "id": "ab-echo", "driver": "scripts/ab-render-perf.mjs" },
    { "id": "ab-flood", "driver": "scripts/ab-render-perf.mjs" },
    { "id": "ab-scroll", "driver": "scripts/ab-render-perf.mjs" },
    { "id": "ab-tui", "driver": "scripts/ab-render-perf.mjs" }
  ],
  "budgets": [
    { "id": "echo-p95", "scenario": "ab-echo", "subject": "dnt-echo", "rule": { "op": "max", "limit": 50 }, "gate": "audit", "minSamples": 10 },
    { "id": "paint-p95", "scenario": "ab-flood", "subject": "dnt-paint", "rule": { "op": "max", "limit": 16 }, "gate": "audit", "minSamples": 50 },
    { "id": "attach-p95", "subject": "dnt-attach", "rule": { "op": "max", "limit": 3000 }, "gate": "audit", "minSamples": 5 },
    { "id": "pipe-broadcast-p95", "subject": "dnt-pipe-broadcast", "rule": { "op": "max", "limit": 40 }, "gate": "audit", "minSamples": 50 }
  ]
}
