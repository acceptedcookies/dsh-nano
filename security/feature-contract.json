  "ui": {
    "dsh-nano-notepad": {
      "launcher": "⌘E then 1 (Windows: Alt+E then 1, Ctrl+E then 1 also accepted) toggles floating panel; circular launcher button",
      "panel": "floating notepad panel: tabs, source/rendered markdown view, format toolbar (.md/.markdown only), JSON tree view (.json), image notes (png/jpeg/gif/webp) in same IndexedDB",
      "settings": "openSettings(initialTab) dialog incl. 'integrate' + 'cloud' tabs; cloud-settings.js edits S3 endpoint profiles via /s3/* routes",
      "pageGlobal": "window.__nanoNotepad.import(name, content, meta) — programmatic draft import",
      "saveDialog": "macOS 'save as' native dialog via POST /nano-notepad/save (osascript), not storage",
      "fetchMp": "mp.weixin.qq.com article import via POST /nano-notepad/fetch-mp"
    },
    "dsh-nano-explorer-extra": {
      "filesType": "takes over the 'Files' right-sidebar tab (sidebarRightTabs.register id nano-explorer-extra, kind files)",
      "tree": "workspace file tree: expand/collapse, click/double-click preview (prefs), context menu (Finder/copy-path/rename/delete/view-diff)",
      "scm": "branch button + commit drawer + worktree list + pull; status bar with branch/conflicts; stats bubble",
      "prefs": "footer gear → per-browser display prefs (localStorage dsh-nano-explorer-extra:prefs.v2, v1 fallback once)",
      "contextMenus": "file/directory context-menu items incl. copy-relative, rename, copy-to-notepad"
    },
    "dsh-nano-model-selector": {
      "trigger": "composer '.nms-trigger' opens single-column icon rail + model list + detail/effort",
      "mediaRail": "'媒体生成' rail section scans & selects local image CLIs",
      "imagine": "/imagine skill registered in composer; injects engine command template — placeholder-free (P3-07): prompt/out stage via imagine/.prompt.txt + imagine/.out.txt, template reads them as data + grep-gates the out name; grok copies ~/.grok creds into workspace imagine/.grok"
    },
    "dsh-nano-kitesurf": {
      "workspace": "sidebar.right kind kitesurf: address bar + history menu, refresh, annotate/arrow on the projected page, note form, settings dialog (UA + viewport radiogroup), pins strip (undo last + send all, cap 8), scroll up/down + wheel scroll",
      "errors": "{ok:false,errorId,error} with mapped status (400 input / 409 phase / 413 body / 502-504 engine); ids kitesurf.url.*, kitesurf.body.json|toolarge, kitesurf.pick.point|failed, kitesurf.shot.scroll|empty, kitesurf.settings.userAgent|viewport, kitesurf.navigate.timeout|failed|egress, kitesurf.engine.connect|closed|timeout|mismatch|failed, kitesurf.lifecycle.state|remote|checkout|origin|mcpPort|action|node|init|start|resume|container, kitesurf.perf.method. Status includes lastError, userAgent, viewport, lifecycle snapshot.",
      "skill": "/kitesurf-cdp + /nano-kite session skills (SKILL.md generated at build from lib/skill.js); agent-browser --cdp against the live cdp from /status, never a local Chrome"
    },
    "dsh-nano-local-sandbox": {
      "surface": "host plugin, no second design pane"
    },
    "dsh-nano-terminal": {
      "surface": "wasm terminal tab via /dnt"
    },
    "dsh-nano-cloud-session": {
      "launcher": "sidebar '云端工作区' section above 工作区; no floating entry / no circular launcher",
      "panel": "native Chat only when H-CHAT exists; otherwise workbench tab hosts API chat + three health faces (api/resources/nativeView). No fake Agent.",
      "ssh": "SSH tab still copies enroll commands; workspace connect bootstraps a Devin-only MCP resource bridge over SSH exec. Dedicated known_hosts file. No /mcp browser entry.",
      "firstRun": "no active profile -> section shows guide row; settings opens on 接入 with carrier preset Devin Cloud and 3-step guide; connect test shows principal_type/orgMatch",
      "settings": "NanoDialog + nanoTabs: 接入/会话/安全/SSH; 接入 folder holds Devin preset, token/org/baseURL, connection test, permission checklist and doc deep links; 会话 holds new-session defaults; 安全 is read-only store policy; SSH is keygen/enroll"
    },
    "dsh-nano-cloud-session-host": "overlay companion of dsh-nano-cloud-session: no web routes and no own UI; disables the stock session-controller, terminal-controller, workspace-files, api-remotes, ui-conversation and ui-sidebar-{right,files,terminal} rows and inserts its derived build (upstream/BASE + upstream/native-host.patch) so external Sessions open in native Chat with capability-filtered files/terminal/attachments tabs; one composite browser module (lib/client.js)",
    "dsh-nano-model-selector-compaction": "host-only companion: mounts ctx.compaction inside preset id:compaction isolate; no web routes, no UI; ON/OFF via dsh.profile.bundles or POST /nano-model-selector/async-compact/switch (route owned by dsh-nano-model-selector)",
    "dsh-nano-progress-report": {
      "tab": "sidebar-right tab kind \"progress\" (id dsh-nano-progress-report.workbench, priority extension, keepMounted): execution event timeline rows (type/status icon, summary, duration), filter input with type:/status:/negation tokens + chips, expandable row detail (args/result/duration), Tasks panel",
      "menuItem": "sidebar-right tab context menu entry \"Open Progress\"/\"打开 Progress\" (slot sidebar.right.tab.menu.item, opens Progress tab in that session)",
      "guide": "sidebar-right add-tab guide lists \"Progress\" entry",
      "hostData": "Browser renders the uiConversation progress projection (no side-channel fetches). A separate host-only summary contributes optional same-session PromptContext."
    }
  },
  "dataLocations": {
    "dsh-nano-notepad": {
      "notes": "IndexedDB 'dsh-nano-notepad' (schema v4: nodes, versions, images, sync cursor store) — per browser origin",
      "s3Profiles": "${DSH_HOME}/nano-notepad-s3.json (mode 0600), seeded from S3_NOTEPAD_* env / ${DSH_HOME}/nano-notepad.env",
      "config": "host Config defaults only (saveDelayMs 800, commitIntervalSec 60, versionLimit 50, imageLimitBytes 5MB, defaultView, theme); panel overrides after first save"
    },
    "dsh-nano-explorer-extra": {
      "prefs": "localStorage 'dsh-nano-explorer-extra:prefs.v2' (v1 read-once fallback)",
      "hostState": "none (no DB); reads session cwd via sessions/sessionPersistence"
    },
    "dsh-nano-model-selector": {
      "engineState": "${DSH_DATA_DIR||DSH_HOME||~/.dsh}/plugins/nano-model-selector/media-engine.json",
      "subagentDefault": "${DSH_DATA_DIR||DSH_HOME||~/.dsh}/plugins/nano-model-selector/subagent-default.json",
      "asyncCompactState": "${DSH_DATA_DIR||DSH_HOME||~/.dsh}/plugins/nano-model-selector/async-compact.json",
      "clientCache": "localStorage 'dsh-nano-model-selector:media-engine.v1' + favorites key"
    },
    "dsh-nano-kitesurf": {
      "lastPick": "in-memory only, cleared on host restart; no browser storage and no last or context route",
      "history": "client in-memory recent addresses (max 8), not persisted",
      "config": "this package does not read a checkout path and does not start a container"
    },
    "dsh-nano-local-sandbox": {
      "state": "per-instance stateVolume: ${DSH_HOME}/nano-local-sandbox/state/<profileId>/<instanceKey>/{browser-state.json,last-page.json,engine}"
    },
    "dsh-nano-terminal": {
      "state": "${DSH_HOME}/dsh-nano-terminal.state/"
    },
    "dsh-nano-cloud-session": {
      "profiles": "${DSH_HOME}/nano-cloud-session.json (mode 0600, write-only secrets), seeded from DEVIN_API_TOKEN/DEVIN_ORG_ID/DEVIN_API_BASE env or ${DSH_HOME}/nano-cloud-session.env",
      "config": "host Config defaults only (requestTimeoutMs 20000, defaultFirst 50, pollIntervalMs 5000); no client-side credential persistence",
      "sshKey": "${DSH_HOME}/nano-cloud-session-ssh{,.pub} (0600, generated via ssh-keygen on demand; private key never leaves host)",
      "prefs": "localStorage 'dsh-nano-cloud-session:defaults.v1' (browser-local new-session defaults; no credentials)",
      "nativeProjection": "in-memory dsh Session per open Devin session (not persisted; Devin remains canonical)",
      "knownHosts": "${DSH_HOME}/nano-cloud-session-known-hosts (0600)",
      "scopes": "in-memory WorkspaceScope only; restart invalidates",
      "remoteBridge": "lib/remote/devin-workspace.mjs hashed into ~/.dncs-bridge/<sha256>/ on the VM; no PAT"
    },
    "dsh-nano-cloud-session-host": {
      "grants": "${DSH_HOME}/nano-cloud-session-grants.json (operator-owned, user-owned 0600 JSON array binding exact external: session ids to SSH targets and roots; read-only to the host, never created/modified/deleted by the plugin; absent = no grants)",
      "preferences": "conversation preferences (busyEnter) under the nano-cloud-session-host settings namespace; stock ui-conversation values are not inherited",
      "knownHosts": "external SSH targets use the grant entry's knownHostsFile; no StrictHostKeyChecking=no"
    },
    "dsh-nano-model-selector-compaction": {
      "asyncCompactState": "${DSH_DATA_DIR||DSH_HOME||~/.dsh}/plugins/nano-model-selector/async-compact.json (written via the sibling DNMS switch route; takeover mutex layer)"
    },
    "dsh-nano-progress-report": {
      "filter": "localStorage 'dsh-nano-progress-report:filter:<sessionId>' — per browser origin, last filter text per session",
      "hostData": "No plugin routes or state files. Host-owned projection checkpoints are rebuildable; optional progress snapshots are logged in the owning session by the host."
    }
  }
