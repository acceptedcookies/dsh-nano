  "ui": {
    "dsh-nano-notepad": {
      "launcher": "⌘E then 1 (Windows: Alt+E then 1, Ctrl+E then 1 also accepted) toggles floating panel; circular launcher button",
      "panel": "floating notepad panel: tabs, source/rendered markdown view, format toolbar (.md/.markdown only), JSON tree view (.json), image notes (png/jpeg/gif/webp) in same IndexedDB",
      "settings": "openSettings(initialTab) dialog incl. 'integrate' + 'cloud' tabs; cloud-settings.js edits S3 endpoint profiles via /s3/* routes",
      "pageGlobal": "window.__nanoNotepad.import(name, content, meta) — programmatic draft import",
      "saveDialog": "macOS 'save as' native dialog via POST /nano-notepad/save (osascript), not storage",
      "fetchMp": "mp.weixin.qq.com article import via POST /nano-notepad/fetch-mp"
    },
    "dsh-nano-explorer-extra": {
      "filesType": "takes over the 'Files' right-sidebar tab (sidebarRightTabs.register id nano-explorer-extra, kind files)",
      "tree": "workspace file tree: expand/collapse, click/double-click preview (prefs), context menu (Finder/copy-path/rename/delete/view-diff)",
      "scm": "branch button + commit drawer + worktree list + pull; status bar with branch/conflicts; stats bubble",
      "prefs": "footer gear → per-browser display prefs (localStorage dsh-nano-explorer-extra:prefs.v2, v1 fallback once)",
      "contextMenus": "file/directory context-menu items incl. copy-relative, rename, copy-to-notepad"
    },
    "dsh-nano-model-selector": {
      "trigger": "composer '.nms-trigger' opens single-column icon rail + model list + detail/effort",
      "mediaRail": "'媒体生成' rail section scans & selects local image CLIs",
      "imagine": "/imagine skill registered in composer; injects engine command template — placeholder-free (P3-07): prompt/out stage via imagine/.prompt.txt + imagine/.out.txt, template reads them as data + grep-gates the out name; grok copies ~/.grok creds into workspace imagine/.grok"
    },
    "dsh-nano-kitesurf": {
      "workspace": "sidebar.right kind kitesurf: address bar + history menu, refresh, annotate/arrow on the projected page, note form, settings dialog (UA + viewport radiogroup + engine origin/MCP), pins strip (undo last + send all, cap 8), scroll up/down + wheel scroll",
      "errors": "{ok:false,errorId,error} with mapped status (400 input / 409 phase / 413 body / 502-504 engine); ids kitesurf.url.*, kitesurf.body.json|toolarge, kitesurf.pick.point|failed, kitesurf.shot.scroll|empty, kitesurf.settings.userAgent|viewport, kitesurf.navigate.timeout|failed|egress, kitesurf.engine.connect|closed|timeout|mismatch|failed, kitesurf.kite.state|remote|checkout|origin|mcpPort|action|node|init|start|resume|container, kitesurf.perf.method. Status includes lastError, userAgent, viewport, kite snapshot.",
      "skill": "/kitesurf-cdp + /nano-kite session skills (SKILL.md generated at build from lib/skill.js); agent-browser --cdp against the live kite.cdp from /status, never a local Chrome"
    },
    "dsh-nano-local-sandbox": {
      "surface": "host plugin, no second design pane"
    },
    "dsh-nano-terminal": {
      "surface": "wasm terminal tab via /dnt"
    }
  },
  "dataLocations": {
    "dsh-nano-notepad": {
      "notes": "IndexedDB 'dsh-nano-notepad' (schema v4: nodes, versions, images, sync cursor store) — per browser origin",
      "s3Profiles": "${DSH_HOME}/nano-notepad-s3.json (mode 0600), seeded from S3_NOTEPAD_* env / ${DSH_HOME}/nano-notepad.env",
      "config": "host Config defaults only (saveDelayMs 800, commitIntervalSec 60, versionLimit 50, imageLimitBytes 5MB, defaultView, theme); panel overrides after first save"
    },
    "dsh-nano-explorer-extra": {
      "prefs": "localStorage 'dsh-nano-explorer-extra:prefs.v2' (v1 read-once fallback)",
      "hostState": "none (no DB); reads session cwd via sessions/sessionPersistence"
    },
    "dsh-nano-model-selector": {
      "engineState": "${DSH_DATA_DIR||DSH_HOME||~/.dsh}/plugins/nano-model-selector/media-engine.json",
      "clientCache": "localStorage 'dsh-nano-model-selector:media-engine.v1' + favorites key"
    },
    "dsh-nano-kitesurf": {
      "lastPick": "in-memory only, cleared on host restart; no browser storage and no last or context route",
      "history": "client in-memory recent addresses (max 8), not persisted",
      "config": "optional perfReview only; this package does not read a checkout path and does not start a container"
    },
    "dsh-nano-local-sandbox": {
      "state": "per-instance stateVolume history.json"
    },
    "dsh-nano-terminal": {
      "state": "${DSH_HOME}/dsh-nano-terminal.state/"
    }
  }
}
