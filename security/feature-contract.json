      "scm": "branch button + commit drawer + worktree list + pull; status bar with branch/conflicts; stats bubble",
      "prefs": "footer gear → per-browser display prefs (localStorage dsh-nano-explorer-extra:prefs.v2, v1 fallback once)",
      "contextMenus": "file/directory context-menu items incl. copy-relative, rename, copy-to-notepad"
